# Dependencies & build (Astro)
node_modules/
dist/
.astro/

# 一次性搬站腳本：預設不進版控，避免讓人以為網站依賴 Python。
# 持續維護的同步器與資料抽取腳本明確 allowlist。
scripts/*
!scripts/sync_official_news.py
!scripts/sync_pet_synthesis.py
!scripts/extract_skill_level_data.py

# 抓取中繼檔（可再產生）
.cache/
_root.html
_sample.html
_pets.html

# Python local
__pycache__/
*.pyc
.venv/

# Secrets / local env — never commit
*.json.key
oauth2service.json
cookies.json
.env
.env.*
!.env.example

# Logs & OS
*.log
.DS_Store
Thumbs.db

# Local browser automation cache
.playwright-cli/
