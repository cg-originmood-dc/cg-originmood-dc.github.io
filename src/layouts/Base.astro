---
import { buildNav } from '../lib/nav';
import NavTree from '../components/NavTree.astro';
import '../styles/global.css';

interface Props {
  title: string;
  breadcrumb?: string[];
  /** 資料庫內嵌模式：右側主區改為全寬白底，容納技能/道具總表 */
  dbEmbed?: boolean;
}
const { title, breadcrumb = [], dbEmbed = false } = Astro.props;
const nav = await buildNav();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// 網址是 percent-encoded，導覽的 href 是中文原字，不解碼的話兩邊永遠對不起來，
// 目前頁面不會反白、所屬分類也不會自動展開。
const here = decodeURIComponent(Astro.url.pathname).replace(/\/$/, '');
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — 永恆初心 Cross Gate 攻略</title>
    <meta name="description" content={`${title}｜魔力寶貝 永恆初心 Cross Gate 攻略資料`} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>

  <body>
    <a class="skip" href="#main">跳到主要內容</a>

    <button class="navtoggle" aria-expanded="false" aria-controls="sidenav">☰ 選單</button>

    <div class="shell">
      <nav id="sidenav" class="sidenav" aria-label="網站導覽">
        <a class="sidenav__brand" href={`${base}/`}>
          <img class="sidenav__mark" src={`${base}/img/logo.gif`} alt="" width="32" height="32" />
          <span>永恆初心 Cross Gate</span>
        </a>
        <NavTree nodes={nav} base={base} here={here} />

        {/* 原站導覽最後一項是外部留言板，不是站內頁面，導覽樹長不出來，補在這裡 */}
        <a class="sidenav__external" href="https://www.tovery.net/guestbook.asp?user=goodluck2cg&page=1" target="_blank" rel="noopener noreferrer">
          初心留言板 ↗
        </a>
      </nav>

      <main id="main">
        <article class:list={['page', { 'is-db-embed': dbEmbed }]}>
          {
            !dbEmbed && breadcrumb.length > 0 && (
              <nav class="crumbs" aria-label="階層">
                <a href={`${base}/`}>首頁</a>
                {breadcrumb.map((c) => (
                  <span>{c}</span>
                ))}
              </nav>
            )
          }
          <slot />
        </article>

        <footer class="sitefoot">
          <p class="sitefoot__thanks">
            特別感謝 <b>Goodluck（固辣可）</b> 以及所有曾經貢獻的人
          </p>
          <p class="sitefoot__meta">
            本站內容整理自
            <a href="https://sites.google.com/view/goodluck2cg/" target="_blank" rel="noopener noreferrer">
              原 Google Sites 站台
            </a>
            ，僅供玩家參考。
          </p>
          <p class="sitefoot__meta">
            由
            <a class="sitefoot__dc" href="https://discord.gg/F5gqG8Grk9" target="_blank" rel="noopener noreferrer">
              魔力寶貝永恆初心 非官方 DC 群
            </a>
            維護
          </p>
          <p class="sitefoot__meta">
            本站為開放原始碼，歡迎提交變更
            <a class="sitefoot__gh" href="https://github.com/cg-originmood-dc/cg-originmood-dc.github.io" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
                <path
                  fill="currentColor"
                  d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38l-.01-1.34c-2.01.37-2.53-.49-2.7-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48l-.01 2.19c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"
                />
              </svg>
              GitHub
            </a>
          </p>
        </footer>
      </main>
    </div>

    <script>
      const btn = document.querySelector<HTMLButtonElement>('.navtoggle');
      const nav = document.getElementById('sidenav');
      btn?.addEventListener('click', () => {
        const open = nav?.classList.toggle('is-open') ?? false;
        btn.setAttribute('aria-expanded', String(open));
      });

      // 靜態站每次換頁都是整頁重載，側欄會捲回最上面。
      // 記住捲動位置，換頁後接回去，深層目錄才不用每次重找。
      const KEY = 'sidenav-scroll';
      if (nav) {
        const saved = sessionStorage.getItem(KEY);
        if (saved) nav.scrollTop = Number(saved);
        // 先把目前頁面捲進視野，沒有記錄時才用得到
        const current = nav.querySelector('[aria-current=page]');
        if (!saved && current) current.scrollIntoView({ block: 'center' });
        addEventListener('beforeunload', () => sessionStorage.setItem(KEY, String(nav.scrollTop)));
      }
    </script>
  </body>
</html>
