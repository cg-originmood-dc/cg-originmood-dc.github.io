---
/**
 * Canonical 技能詳情路由，對齊 main 的三分法：
 * /skill/char/、/skill/pet/、/skill/shared/。
 * 詳情資料仍由目前分支的技能庫.csv／技能等級.csv 組合而成。
 */
import Base from '../../../layouts/Base.astro';
import SkillDetail from '../../../components/SkillDetail.astro';
import { listSkillEntries, skillScope, type SkillEntry } from '../../../lib/skillData';

export function getStaticPaths() {
  return listSkillEntries().flatMap((entry) => {
    const scope = skillScope(entry.name);
    return scope
      ? [{ params: { scope, name: entry.name }, props: { entry } }]
      : [];
  });
}

const { entry } = Astro.props as { entry: SkillEntry };
---

<Base title={`${entry.name} - 技能詳情`}>
  <SkillDetail entry={entry} />
</Base>
