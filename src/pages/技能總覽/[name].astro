---
import Base from '../../layouts/Base.astro';
import SkillDetail from '../../components/SkillDetail.astro';
import { listSkillPages, type SkillRecord } from '../../lib/skillData';

export function getStaticPaths() {
  return listSkillPages().map((skill) => ({ params: { name: skill.技能名稱 }, props: { skill } }));
}

const { name } = Astro.params;
const { skill } = Astro.props as { skill: SkillRecord };
---

<Base title={`${name} - 技能詳情`} breadcrumb={['技能總覽']}>
  <SkillDetail skill={skill} />
</Base>
