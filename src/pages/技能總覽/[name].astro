---
import Base from '../../layouts/Base.astro';
import DbEmbed from '../../components/DbEmbed.astro';
import { readdirSync } from 'node:fs';
import { join } from 'node:path';

export function getStaticPaths() {
  const dir = join(process.cwd(), 'public', '資料庫', 'skills');
  try {
    return readdirSync(dir)
      .filter((f) => f.endsWith('.html'))
      .map((f) => ({ params: { name: f.replace(/\.html$/, '') } }));
  } catch {
    return [];
  }
}

const { name } = Astro.params;
---

<Base title={`${name} - 技能詳情`} dbEmbed>
  <DbEmbed src={`skills/${name}.html`} />
</Base>
