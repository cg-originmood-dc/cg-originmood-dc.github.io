---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import DataTable from '../components/DataTable.astro';
import ExclusiveSkills from '../components/ExclusiveSkills.astro';
import PetList from '../components/PetList.astro';
import PetIslandTabs from '../components/PetIslandTabs.astro';
import PetSynthesisTables from '../components/PetSynthesisTables.astro';
import SkillIndex from '../components/SkillIndex.astro';
import SourceNote from '../components/SourceNote.astro';
import { datasetHeading } from '../lib/dataset-headings';
import { HOME_ID } from '../lib/nav';

export async function getStaticPaths() {
  const entries = await getCollection('pages');
  return entries
    .filter((entry) => entry.id !== HOME_ID)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const hasProse = entry.body != null && entry.body.trim().length > 0;
---

<Base title={entry.data.title} breadcrumb={entry.data.breadcrumb}>
  <h1 class="page-title">{entry.data.title}</h1>

  {hasProse && (
    <div class="prose">
      <Content />
    </div>
  )}

  {entry.data.title === '週年慶寵物島' ? (
    <PetIslandTabs />
  ) : entry.data.title === '寵物合成活動' ? (
    <PetSynthesisTables />
  ) : entry.data.title === '技能總覽' ? (
    <SkillIndex />
  ) : entry.data.title === '寵物清單' ? (
    <PetList />
  ) : entry.data.title === '專屬技能' ? (
    <ExclusiveSkills />
  ) : (
    entry.data.datasets.map((name) => {
      const heading = datasetHeading(entry.id, name, entry.data.datasets.length);
      return (
        <>
          {heading && <h2 class="dataset__title">{heading}</h2>}
          <DataTable name={name} />
        </>
      );
    })
  )}

  <SourceNote sourceUrl={entry.data.sourceUrl} />
</Base>
