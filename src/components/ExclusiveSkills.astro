---
/**
 * 專屬技能：各職業專屬技能一覽（對照原站「專屬技能」頁的手風琴）。
 * 這頁自己的資料只有 content/data/專屬技能.csv 三欄——哪些技能、職業歸屬、
 * 官網來源連結；等級表一律取自技能 SSOT（技能總覽.csv＋技能等級效果.csv），
 * 不再另存一份（原本 19 張 專屬技能-N.csv 跟等級效果表重複，已刪）。
 */
import { loadDataset } from '../lib/datasets';
import { getSkill, skillPath, skillIcon, mpLabel } from '../lib/skills';
import { renderCell } from '../lib/richtext';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rows = loadDataset('專屬技能')?.rows ?? [];
const skills = rows.map((r) => {
  const name = (r.技能 ?? '').trim();
  const entry = getSkill(name);
  const side = entry?.char ?? entry?.pet ?? null;
  const path = skillPath(name);
  return {
    name,
    job: r.職業歸屬 ?? '',
    source: r.官網來源 ?? '',
    side,
    href: path ? `${base}${path}` : null,
    levels: side ? [...side.levels].sort((a, b) => Number(a.等級) - Number(b.等級)) : [],
  };
});
---

<div class="exclusive-skills">
  {skills.map((s) => (
    <section class="exskill" id={s.name}>
      <header class="exskill__head">
        <h2>
          {s.side && <span aria-hidden="true">{skillIcon(s.side.分類)}</span>}
          {s.href ? <a href={s.href}>{s.name}</a> : s.name}
        </h2>
        <span class="exskill__job">{s.job}</span>
      </header>
      {s.levels.length ? (
        <table class="exskill__levels">
          <thead>
            <tr>
              {s.side?.最高等級 && <th>等級</th>}
              <th>專屬耗魔</th>
              <th>技能說明</th>
            </tr>
          </thead>
          <tbody>
            {s.levels.map((l) => (
              <tr>
                {s.side?.最高等級 && <td class="lv">LV {l.等級}</td>}
                <td class="mp">{mpLabel(l.魔力消耗)}</td>
                <td class="eff">{l.效果 || '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="exskill__missing">技能資料庫中查無此技能的等級資料。</p>
      )}
      {s.source && <p class="exskill__src" set:html={renderCell(s.source, base)} />}
    </section>
  ))}
</div>

<style>
  .exskill {
    margin-bottom: 26px;
  }
  .exskill__head {
    display: flex;
    align-items: baseline;
    gap: 10px;
    background: #f1f3f4;
    border-left: 5px solid #1155cc;
    padding: 8px 12px;
  }
  .exskill__head h2 {
    margin: 0;
    font-size: 1.05rem;
  }
  .exskill__head a {
    text-decoration: none;
  }
  .exskill__head a:hover {
    text-decoration: underline;
  }
  .exskill__job {
    color: #5f6368;
    font-size: 0.85rem;
  }
  .exskill__levels {
    width: 100%;
    border-collapse: collapse;
    text-align: center;
  }
  .exskill__levels th {
    background: #f1f3f4;
    color: #1155cc;
    font-size: 12px;
    padding: 7px;
    border-bottom: 2px solid #1155cc;
  }
  .exskill__levels td {
    padding: 7px 6px;
    border-bottom: 1px solid #eee;
    font-size: 13px;
  }
  .exskill__levels .lv {
    font-weight: 700;
    color: #008be3;
    white-space: nowrap;
  }
  .exskill__levels .mp {
    color: #e65100;
    font-weight: 700;
    white-space: nowrap;
  }
  .exskill__levels .eff {
    text-align: left;
  }
  .exskill__src {
    margin: 6px 0 0;
    font-size: 0.85rem;
    color: #5f6368;
  }
  .exskill__missing {
    color: #9e9e9e;
  }
</style>
