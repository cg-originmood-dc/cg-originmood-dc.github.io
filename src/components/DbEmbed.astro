---
import { loadDbHtml } from '../lib/dbEmbed';

interface Props {
  /** public/資料庫/ 底下的相對路徑，例如 skills.html 或 skills/連擊.html */
  src: string;
}
const { src } = Astro.props;
const { style, body, scripts } = loadDbHtml(src);
---

{
  /*
   * 注意：set:html 插入的 <script> 不會被瀏覽器執行。
   * 因此 loadDbHtml 會抽出 scripts，這裡再以 createElement 掛上。
   */
}
<div class="db-embed-shell" set:html={`<style>${style}</style><div class="db-embed">${body}</div>`} />

{
  scripts.length > 0 && (
    <script is:inline define:vars={{ dbEmbedScripts: scripts }}>
      (function () {
        var list = dbEmbedScripts || [];
        for (var i = 0; i < list.length; i++) {
          var s = document.createElement('script');
          s.text = list[i];
          document.body.appendChild(s);
        }
      })();
    </script>
  )
}

<style is:global>
  /* 內嵌資料庫：白底、撐滿右側內容區（符合原站版面） */
  main:has(.is-db-embed) {
    padding: 0.5rem clamp(0.35rem, 1vw, 0.75rem) 1.25rem;
  }
  .page.is-db-embed {
    max-width: none;
    width: 100%;
    margin-inline: 0;
    padding: 0;
    background: #ffffff;
    border: 1px solid var(--border, #e0e0e0);
  }
  .page.is-db-embed > .page-title,
  .page.is-db-embed > .crumbs {
    display: none;
  }
  .db-embed-shell {
    width: 100%;
    min-height: calc(100vh - 4rem);
  }
  .db-embed {
    min-height: calc(100vh - 4rem);
    padding: 12px clamp(10px, 1.5vw, 20px) 28px;
    background: #ffffff;
    color: #212121;
  }
  /* 全寬利用右側版面，不再縮在中間窄欄 */
  .db-embed #wrapper,
  .db-embed .container-fluid {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    box-sizing: border-box;
  }
</style>
