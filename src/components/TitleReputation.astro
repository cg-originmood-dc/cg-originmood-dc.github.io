<script>
  document.querySelectorAll<HTMLElement>('[data-rt]').forEach((root) => {
    type Track = { group: string; ladder: { title: string; cum: number | null }[] };
    const tracks: Track[] = JSON.parse(root.dataset.tracks ?? '[]');
    const fmt = (n: number) => n.toLocaleString('en-US');
    const CAP = 1600;

    const trackSel = root.querySelector<HTMLSelectElement>('[data-track]')!;
    const curSel = root.querySelector<HTMLSelectElement>('[data-calc-cur]')!;
    const targetSel = root.querySelector<HTMLSelectElement>('[data-calc-target]')!;

    /** 換職業群：階梯表、職業清單、計算機的選項全部跟著換 */
    const pickTrack = (group: string) => {
      for (const el of root.querySelectorAll<HTMLElement>('[data-track-table], [data-track-info]')) {
        el.hidden = (el.dataset.trackTable ?? el.dataset.trackInfo) !== group;
      }
      const ladder = tracks.find((t) => t.group === group)?.ladder ?? [];
      curSel.replaceChildren();
      targetSel.replaceChildren();
      for (const [i, l] of ladder.entries()) {
        if (l.cum === null) continue; // 待補階（無際的青空、賢者之石擁有者）不進計算機
        const opt = new Option(l.title, String(l.cum));
        curSel.add(opt.cloneNode(true) as HTMLOptionElement);
        if (i > 0) targetSel.add(opt);
      }
      curSel.selectedIndex = 0;
      targetSel.selectedIndex = 0;
    };

    const update = () => {
      const cur = Number(curSel.value);
      const target = Number(targetSel.value);
      const remain = Math.max(0, target - cur);

      const progress = root.querySelector<HTMLElement>('[data-calc-progress]')!;
      const done = root.querySelector<HTMLElement>('[data-calc-done]')!;
      progress.hidden = remain === 0;
      done.hidden = remain > 0;
      if (remain > 0) {
        const days = Math.ceil(remain / CAP);
        // 每天登入 +100 也算在額度內，總場數把它扣掉
        const byFight = Math.max(0, remain - days * 100);
        root.querySelector('[data-calc-remain]')!.textContent = fmt(remain);
        root.querySelector('[data-calc-days]')!.textContent = String(days);
        root.querySelector('[data-calc-gira-total]')!.textContent = fmt(Math.ceil(byFight / 70));
        root.querySelector('[data-calc-lidong-total]')!.textContent = fmt(Math.ceil(byFight / 30));
      }
    };

    // 選了目前稱號後，目標若不在其後，自動跳到下一階
    curSel.addEventListener('change', () => {
      const cur = Number(curSel.value);
      if (Number(targetSel.value) <= cur) {
        const next = [...targetSel.options].find((o) => Number(o.value) > cur);
        if (next) targetSel.value = next.value;
      }
      update();
    });
    targetSel.addEventListener('change', update);
    trackSel.addEventListener('change', () => {
      pickTrack(trackSel.value);
      update();
    });
    pickTrack(trackSel.value);
    update();
  });
</script>

