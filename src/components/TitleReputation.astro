---
/**
 * 稱號與聲望頁，依 design_handoff_聲望稱號攻略 設計稿實作。
 * 閱讀動線：核心觀念（時間鎖）→ 通用規則（吉拉算例）→ 各職業日課 →
 * 刷聲望地點 → 稱號階梯 → 「還要幾天」計算機 → 完整數值表（收合查證用）。
 *
 * 資料來源（content/data/）：
 * - 稱號階梯.csv     四個職業群各一條階梯；「升上此階天數」由差額 ÷ 每日上限算出
 * - 稱號職業群.csv   哪些職業走哪一條階梯，兼作階梯表的職業群選單來源
 * - 晉階條件.csv     四關晉階任務的技能／等級／稱號／階級需求
 * - 聲望刷點.csv     競技場六王與里洞的「角色等級區間 → 聲望」對照，
 *                    「連結」欄有值時地點名稱連到站內頁（里洞連推薦練功攻略）
 * - 聲望日課.csv     各職業每天做的事（手風琴）
 * - 聲望行為.csv     完整數值表（共通與各職業系）
 * - 稱號NPC.csv      領稱號與問進度的 NPC 位置表
 *
 * 計算機為純 client state，每日上限固定 1600（初心玩家實測反推）。
 * 選了目前稱號後，目標稱號若不在其後會自動跳到下一階。
 */
import { LIST_SEP, loadDataset } from '../lib/datasets';

const get = (r: Record<string, string>, k: string) => (r[k] ?? '').trim();
const split = (v: string) => v.split(LIST_SEP).map((s) => s.trim()).filter(Boolean);

const ladderRows = loadDataset('稱號階梯')?.rows ?? [];
const trackRows = loadDataset('稱號職業群')?.rows ?? [];
const promoRows = loadDataset('晉階條件')?.rows ?? [];
const spotRows = loadDataset('聲望刷點')?.rows ?? [];
const dailyRows = loadDataset('聲望日課')?.rows ?? [];
const actionRows = loadDataset('聲望行為')?.rows ?? [];
const npcRows = loadDataset('稱號NPC')?.rows ?? [];

const claimNpcs = npcRows.filter((r) => get(r, '用途') === '領稱號');
const progressNpcs = npcRows.filter((r) => get(r, '用途') === '問進度');

/**
 * 稱號軌：一個職業群一條階梯。生產／服務／採集三軌的稱號名相同、門檻不同，
 * 所以是「先選職業群，再看階梯」，不是四欄並排。
 * diff 為數字才能算天數，天數以每日上限 1600 計算。
 */
const tracks = trackRows.map((t) => {
  const group = get(t, '職業群');
  const rows = ladderRows
    .filter((r) => get(r, '職業群') === group)
    .map((r) => {
      const diff = Number(get(r, '與前階差額'));
      return {
        title: get(r, '稱號'),
        total: get(r, '累積聲望'),
        diff: Number.isFinite(diff) ? diff : null,
        jira: get(r, '吉拉場數(約)'),
        promote: get(r, '可晉階'),
      };
    });
  return {
    group,
    jobs: split(get(t, '適用職業')),
    claim: get(t, '領取方式'),
    note: get(t, '說明'),
    rows,
    // 只有戰鬥系那一軌填了吉拉場數，其他軌整欄空的就別佔一欄寬度
    hasJira: rows.some((r) => r.jira !== '-'),
  };
});
const fmt = (n: number) => n.toLocaleString('en-US');

/** 晉階條件：一關一張卡，卡內一列一個職業群 */
const stages = [...new Set(promoRows.map((r) => get(r, '階段')))].map((no) => {
  const rows = promoRows.filter((r) => get(r, '階段') === no);
  return {
    no,
    // 同一關的戰鬥系與生產系升的階級不同名（王宮／資深），兩個都要寫出來
    ranks: [...new Set(rows.map((r) => `${get(r, '前一階級')} → ${get(r, '晉階')}`))],
    // 備註常常整關通用（神獸的兩人限制對兩個戰鬥系群都成立），收在表格下方列一次就好
    notes: [...new Set(rows.map((r) => get(r, '備註')).filter(Boolean))],
    rows: rows.map((r) => ({
      group: get(r, '職業群'),
      jobs: split(get(r, '適用職業')),
      need: get(r, '技能需求') !== '-' ? `專職技能 ${get(r, '技能需求')}` : `人物等級 ${get(r, '等級需求')}`,
      bySkill: get(r, '技能需求') !== '-',
      title: get(r, '需求稱號'),
      from: get(r, '前一階級'),
      to: get(r, '晉階'),
      quest: get(r, '任務'),
      route: get(r, '路線'),
      link: get(r, '連結'),
      note: get(r, '備註'),
    })),
  };
});

/** 刷點：以（分組, 地點）分組成卡片；聲望最高的區間列是甜蜜區 */
type Bracket = { range: string; rep: string; dead: boolean };
type Spot = {
  group: string;
  name: string;
  lv: string;
  sub: string;
  note: string;
  link: string;
  brackets: Bracket[];
  sweet: number;
};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const spotList: Spot[] = [];
for (const r of spotRows) {
  const key = `${get(r, '分組')}|${get(r, '地點')}`;
  let spot = spotList.find((s) => `${s.group}|${s.name}` === key);
  if (!spot) {
    spot = {
      group: get(r, '分組'),
      name: get(r, '地點'),
      lv: get(r, '對象等級'),
      sub: get(r, '副標'),
      note: '',
      link: '',
      brackets: [],
      sweet: -1,
    };
    spotList.push(spot);
  }
  if (get(r, '地點備註')) spot.note = get(r, '地點備註');
  if (get(r, '連結')) spot.link = get(r, '連結');
  spot.brackets.push({
    range: get(r, '角色等級'),
    rep: get(r, '聲望'),
    dead: get(r, '聲望') === '無聲望',
  });
}
for (const s of spotList) {
  // 甜蜜區＝聲望數值最高的那一列
  let best = -1;
  s.brackets.forEach((b, i) => {
    const v = Number(b.rep.replace(/[^0-9]/g, ''));
    if (!b.dead && v > (best === -1 ? -Infinity : Number(s.brackets[best].rep.replace(/[^0-9]/g, '')))) best = i;
  });
  s.sweet = best;
}
const spotGroups = ['競技場', '練功地點']
  .map((g) => ({ name: g, spots: spotList.filter((s) => s.group === g) }))
  .filter((g) => g.spots.length > 0);

/** 手風琴：細節欄以 LIST_SEP 切成 bullet */
const daily = dailyRows
  .sort((a, b) => Number(get(a, '順序')) - Number(get(b, '順序')))
  .map((r) => ({
    job: get(r, '職業'),
    line: get(r, '結論'),
    value: get(r, '聲望值'),
    dim: get(r, '聲望值').includes('0.5'),
    details: split(get(r, '細節')),
  }));

const commonActions = actionRows.filter((r) => get(r, '職業系') === '共通');
const typedActions = actionRows.filter((r) => get(r, '職業系') !== '共通');

const NAV = [
  { href: '#rules', label: '怎麼算' },
  { href: '#daily', label: '各職業' },
  { href: '#spots', label: '去哪刷' },
  { href: '#ladder', label: '稱號階梯' },
  { href: '#promote', label: '晉階條件' },
  { href: '#calc', label: '還要幾天', accent: true },
  { href: '#tables', label: '完整數值' },
];

const SOURCES = [
  { text: '巴哈姆特：名聲表實測', href: 'https://forum.gamer.com.tw/C.php?bsn=02577&snA=146166' },
  { text: '巴哈姆特：稱號聲望需求與吉拉場數', href: 'https://forum.gamer.com.tw/C.php?bsn=02577&snA=141553' },
  { text: '蔚藍幻境：稱號升降', href: 'https://cg.skyey.tw/part/7/index.htm' },
  { text: '巴哈姆特：永恆初心轉職聲望討論', href: 'https://forum.gamer.com.tw/C.php?bsn=70151&snA=3381' },
];

/** 計算機用的階梯資料（無名的旅人累積=0；待補階排除），跟著職業群一起切換 */
const calcTracks = tracks.map((t) => ({
  group: t.group,
  ladder: t.rows.map((l) => ({
    title: l.title,
    cum: l.total === '-' ? 0 : Number(l.total.replace(/[^0-9]/g, '')) || null,
  })),
}));
---

<div class="rt" data-rt data-tracks={JSON.stringify(calcTracks)}>
  <!-- Sticky 導覽 -->
  <nav class="rt__nav" aria-label="頁內導覽">
    {NAV.map((n) => (
      <a href={n.href} class:list={{ 'is-accent': n.accent }}>
        {n.label}
      </a>
    ))}
  </nav>

  <!-- 核心觀念：時間鎖 -->
  <section class="rt__card rt__timelock">
    <h3>稱號是時間鎖，每天把聲望額度打滿就是最快。</h3>
    <p>
      系統每天自動發 <strong>1,600 點</strong>額度，<strong>沒上線也照發</strong>，最多囤
      6 天。打滿之後再怎麼刷都不會增加。
    </p>
    <div class="rt__quota" aria-hidden="true">
      <div class="rt__quota-cell is-today">
        <b>1,600</b>
        <span>今天</span>
      </div>
      {[...Array(5)].map(() => (
        <div class="rt__quota-cell is-bank">
          <b>+1,600</b>
          <span>沒上線</span>
        </div>
      ))}
      <div class="rt__quota-eq">=</div>
      <div class="rt__quota-cell is-full">
        <b>9,600</b>
        <span>囤滿上限</span>
      </div>
    </div>
    <p class="rt__timelock-foot">超過 6 天不上線，多的就浪費了。至少每 6 天上線清一次庫存。</p>
  </section>

  <!-- #rules 通用規則 -->
  <section id="rules" class="rt__section">
    <h2>聲望怎麼算？看一場吉拉就懂</h2>
    <p class="rt__subnote">數值為玩家實測。</p>

    <div class="rt__card">
      <p class="rt__formula-label">競技場（吉拉）一場</p>
      <div class="rt__formula">
        <div class="rt__tile is-green">
          <b>+10</b>
          <span>戰鬥勝利</span>
          <small>沒出手的隊員也有</small>
        </div>
        <div class="rt__op">＋</div>
        <div class="rt__tile is-green">
          <b>+50</b>
          <span>王加成</span>
          <small>尾刀要自己收，合擊不算</small>
        </div>
        <div class="rt__op">＋</div>
        <div class="rt__tile is-gold">
          <b>+10</b>
          <span>打死有效怪</span>
          <small>自己補刀的每一隻</small>
        </div>
        <div class="rt__op">＝</div>
        <div class="rt__tile is-blue">
          <b>+70</b>
          <span>一場合計</span>
          <small>約 23 場打滿一天額度</small>
        </div>
      </div>
      <p class="rt__formula-label">練功（里洞）一場</p>
      <div class="rt__formula">
        <div class="rt__tile is-green">
          <b>+10</b>
          <span>戰鬥勝利</span>
          <small>沒出手的隊員也有</small>
        </div>
        <div class="rt__op">＋</div>
        <div class="rt__tile is-gold">
          <b>+10/隻</b>
          <span>打死有效怪</span>
          <small>怪越多越快</small>
        </div>
        <div class="rt__op">＝</div>
        <div class="rt__tile is-blue">
          <b>+20 起</b>
          <span>一場合計</span>
          <small>平均殺 3 隻約 +40</small>
        </div>
      </div>
      <div class="rt__legend">
        <span><i class="rt__swatch is-green"></i>怪物等級 ≥ 自己等級 ÷ 2 − 3（捨去小數）</span>
        <span><i class="rt__swatch is-gold"></i>怪物等級 ≥ 自己等級 ÷ 4 − 3（捨去小數）</span>
      </div>
      <p class="rt__premise">三份超過門檻即各自消失：吉拉 53 等剩 +20、54 等剩 +10、108 等歸零，各王分段見「去哪刷」。</p>
    </div>

    <div class="rt__cards2">
      <div class="rt__card">
        <h4>其他加分</h4>
        <ul class="rt__kv">
          <li><span>每日登入獎勵</span><b class="is-plus">+100</b></li>
          <li><span>打死怪（每隻，等級範圍內才有）</span><b class="is-plus">+10</b></li>
        </ul>
      </div>
      <div class="rt__card is-red">
        <h4>扣分與歸零</h4>
        <ul class="rt__kv">
          <li><span>戰鬥中逃跑或登出</span><b class="is-minus">−10</b></li>
          <li><span>戰鬥中死亡</span><b class="is-minus">−10</b></li>
          <li><span>轉職、回復遊民</span><b class="is-minus">歸零</b></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- #daily 各職業日課 -->
  <section id="daily" class="rt__section">
    <h2>再來看細的：你的職業，每天做這件事</h2>
    <div class="rt__card rt__accordion">
      {daily.map((d) => (
        <details>
          <summary>
            <span class="rt__badge">{d.job}</span>
            <span class="rt__line">{d.line}</span>
            <b class:list={['rt__val', { 'is-dim': d.dim }]}>{d.value}</b>
            <span class="rt__caret">▾</span>
          </summary>
          <ul>
            {d.details.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </details>
      ))}
    </div>
    <div class="rt__card rt__npc">
      <h4>聲望到門檻後怎麼領稱號？</h4>
      <p>戰鬥職業不會自動升，先登出再登入，找 NPC 領取。生產職業自動升，免找 NPC。</p>
      <div class="rt__tablewrap">
        <table>
          <thead>
            <tr><th>NPC</th><th>位置</th></tr>
          </thead>
          <tbody>
            {claimNpcs.map((r) => (
              <tr>
                <td>{get(r, 'NPC')}</td>
                <td>{get(r, '位置')}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <h4 class="rt__npc-sub">想知道升稱號的進度？找事情通</h4>
      <div class="rt__tablewrap">
        <table>
          <thead>
            <tr><th>NPC</th><th>位置</th><th>備註</th></tr>
          </thead>
          <tbody>
            {progressNpcs.map((r) => (
              <tr>
                <td>{get(r, 'NPC')}</td>
                <td>{get(r, '位置')}</td>
                <td class="rt__notecell">{get(r, '備註')}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- #spots 刷聲望地點 -->
  <section id="spots" class="rt__section">
    <h2>去哪裡刷？看你的等級</h2>
    <p class="rt__subnote">同一個王，等級越高聲望越少，超過上限直接沒聲望。綠色是你該去的甜蜜區。</p>
    {spotGroups.map((group) => (
      <>
        <h3 class="rt__grouphead">{group.name}</h3>
        <div class="rt__spots">
          {group.spots.map((spot, i) => (
            <div class:list={['rt__spot', { 'is-first': group.name === '競技場' && i === 0 }]}>
              <div class="rt__spot-head">
                <div>
                  {spot.link ? (
                    <b><a href={base + spot.link}>{spot.name}</a></b>
                  ) : (
                    <b>{spot.name}</b>
                  )}
                  {spot.sub && <small>{spot.sub}</small>}
                </div>
                <span class="rt__spot-lv">Lv.{spot.lv}</span>
              </div>
              <ul class="rt__brackets">
                {spot.brackets.map((b, bi) => (
                  <li class:list={{ 'is-sweet': bi === spot.sweet, 'is-dead': b.dead }}>
                    <span>{b.range}</span>
                    <b>{b.rep}</b>
                  </li>
                ))}
              </ul>
              {spot.note && <p class="rt__spot-note">{spot.note}</p>}
            </div>
          ))}
        </div>
      </>
    ))}
  </section>

  <!-- #ladder 稱號階梯 -->
  <section id="ladder" class="rt__section">
    <h2>稱號階梯</h2>
    <p class="rt__subnote">
      四個職業群各走各的階梯：稱號名不同、門檻也不同。選你的職業群，再找現在的稱號往右看要幾天。
    </p>
    <div class="rt__card rt__trackpick">
      <label>
        職業群
        <select data-track>
          {tracks.map((t) => (
            <option value={t.group}>{t.group}</option>
          ))}
        </select>
      </label>
      {tracks.map((t) => (
        <div class="rt__trackinfo" data-track-info={t.group} hidden>
          <p class="rt__trackjobs">{t.jobs.join('、')}</p>
          <p class="rt__trackmeta">
            <b>{t.claim}</b>
            {t.note && <span>{t.note}</span>}
          </p>
        </div>
      ))}
    </div>
    <div class="rt__card rt__tablewrap">
      {tracks.map((t) => (
        <table data-track-table={t.group} hidden>
          <thead>
            <tr>
              <th>稱號</th>
              <th class="is-num">累積聲望</th>
              {t.hasJira && <th class="is-num">吉拉場數(約)</th>}
              <th class="is-num">升上此階天數</th>
              <th>可晉階</th>
            </tr>
          </thead>
          <tbody>
            {t.rows.map((row) => (
              <tr class:list={{ 'is-gate': row.promote !== '' }}>
                <td>{row.title}</td>
                <td class="is-num is-blue">{row.total === '-' ? '—' : row.total === '待補' ? '待補' : fmt(Number(row.total))}</td>
                {t.hasJira && <td class="is-num">{row.jira === '-' ? '—' : row.jira}</td>}
                <td class="is-num is-green">
                  {row.diff ? `約 ${Math.ceil(row.diff / 1600)} 天` : '—'}
                </td>
                <td>{row.promote ? <span class="rt__gate">{row.promote}</span> : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      ))}
    </div>
    <details class="rt__fineprint">
      <summary>數值假設與注意事項</summary>
      <ul>
        <li>聲望數值為舊正服玩家實測值，永恆初心可能有出入，歡迎實測回報。</li>
        <li>每日上限 1,600 為初心玩家轉職後實測反推（累積 6 天＝9,600），尚有爭議；舊正服為 800。</li>
        <li>吉拉一場約 +70，需符合「王的平均等級 ≥ 自己等級 ÷ 2 − 3（捨去小數）」才拿得滿。</li>
        <li>有效怪判定：怪物等級 ≥ 自己等級 ÷ 4 − 3（捨去小數），不符合則無聲望。換算過來就是「自己等級超過 怪物等級 × 4 ＋ 15 就沒有聲望」，與競技場六王及里洞的實測區間全部吻合。</li>
        <li>轉職聲望歸零，且永恆初心不保留聲望上限（官方客服回覆）。</li>
        <li>生產、服務、採集三軌的門檻與晉階條件出自舊服玩家整理，稱號名與階級名已對照永恆初心站內資料校正（大師／名師、王宮／資深、師範／御用），數值本身尚未在初心實測。</li>
      </ul>
    </details>
  </section>

  <!-- #promote 晉階條件 -->
  <section id="promote" class="rt__section">
    <h2>稱號拿到之後：晉階條件</h2>
    <p class="rt__subnote">
      稱號只是門票。四關都是同一個組合：<b>專職技能等級（或人物等級）＋ 稱號 ＋ 打指定任務</b>。
    </p>
    {stages.map((stage) => (
      <div class="rt__card rt__stage">
        <h3>
