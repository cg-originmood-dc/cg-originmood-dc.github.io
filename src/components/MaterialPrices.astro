---
/**
 * 材料單價維護頁。把所有配方會用到的材料攤成一張表，單價記
 * localStorage（鍵 craftcost:price:<材料名>），與成本計算頁同鍵共用——
 * 這裡填好，計算機選什麼產品都自動帶入。
 *
 * 清單由配方推導（listMaterials），介面不自寫材料清單；
 * 市價沒有「正確值」，不落資料層。匯出／匯入走剪貼簿文字
 * （一行一筆「名稱、Tab、價格」），方便朋友間分享行情或搬裝置。
 *
 * 輸入框收「一組」的價格——礦、木、食材、花材、礦條等市場都照組喊價，
 * 免除心算；一組幾個每列可調（預設 40＝本服最大堆疊，論個賣的設 1），
 * 存 craftcost:stack:<材料名>。localStorage 的價一律記 1 個的價，
 * 與成本計算頁同鍵互通；匯出／匯入跟輸入框同單位並帶組數（所見即所貼）。
 */
import { listMaterials, loadNpcPrices, DEFAULT_STACK } from '../lib/craftCost';
import { getItem, itemImagePath } from '../lib/items';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const npcPrices = loadNpcPrices();

type Row = { n: string; cat: string; lv: string; href: string | null; img: string; npc?: number };
const rows: Row[] = listMaterials().map((n) => {
  const it = getItem(n);
  return {
    // cat 只當排序鍵讓同類材料相鄰，不顯示（道具庫分類還很亂，欄位先拿掉）
    n,
    cat: (it?.子分類 || it?.分類 || '').trim() || '未收錄',
    lv: (it?.等級 ?? '').trim(),
    href: it ? `${base}/道具總覽/${encodeURIComponent(n)}` : null,
    img: itemImagePath(n),
    npc: npcPrices[n],
  };
});

// 分類照字典序、同分類照等級再照名稱；「未收錄」（道具庫還沒有的）壓底
const collator = new Intl.Collator('zh-Hant', { numeric: true });
const lvNum = (lv: string) => {
  const n = Number(lv);
  return lv !== '' && Number.isFinite(n) ? n : 99;
};
rows.sort((a, b) => {
  if (a.cat !== b.cat) {
    if (a.cat === '未收錄') return 1;
    if (b.cat === '未收錄') return -1;
    return collator.compare(a.cat, b.cat);
  }
  if (lvNum(a.lv) !== lvNum(b.lv)) return lvNum(a.lv) - lvNum(b.lv);
  return collator.compare(a.n, b.n);
});
---

<section class="mp" data-matprice hidden>
  <div class="mp__bar">
    <input type="search" data-filter placeholder="輸入材料名過濾…" />
    <span class="mp__count" data-counter></span>
    <button type="button" data-clear>清除全部單價</button>
  </div>

  <table class="mp__table">
    <thead>
      <tr>
        <th>材料</th>
        <th>等級</th>
        <th>NPC售價</th>
        <th>價格</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr data-row data-name={r.n}>
          <td class="mp__name">
            {r.img && <img src={r.img} alt="" loading="lazy" />}
            {r.href ? <a href={r.href}>{r.n}</a> : r.n}
          </td>
          <td>{r.lv || '—'}</td>
          <td>{r.npc != null ? `${r.npc} G` : '—'}</td>
          <td class="mp__price">
            <input
              type="number"
              min="0"
              step="any"
              data-mat={r.n}
              data-npc={r.npc != null ? String(r.npc) : undefined}
            />
            <small class="mp__unit"
              >／組(<input
                type="number"
                min="1"
                step="1"
                value={String(DEFAULT_STACK)}
                class="mp__stackin"
                data-stackinput
                aria-label={`${r.n} 一組幾個`}
              />個)</small
            >
            <small class="mp__per" data-per></small>
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  <details class="mp__io" open>
    <summary>批次匯出／匯入行情</summary>
    <p>
      「匯出並複製」會把已填的價格整理成一行一筆「材料名（Tab）一組價（Tab）一組幾個」直接進剪貼簿，
      貼給朋友就能對行情；把別人分享的內容貼進框內按「從框內匯入」即可批次帶入
      （也吃「名稱=價格」「名稱,價格,組數」等寫法，沒帶組數就照你目前的組數解讀）。
    </p>
    <textarea data-io rows="8" spellcheck="false"></textarea>
    <div class="mp__io-btns">
      <button type="button" data-export>匯出並複製</button>
      <button type="button" data-import>從框內匯入</button>
      <span class="mp__io-status" data-io-status></span>
    </div>
  </details>
</section>
<noscript><p>材料價格維護需要開啟 JavaScript 才能使用。</p></noscript>

<script>
  document.querySelectorAll<HTMLElement>('[data-matprice]').forEach((root) => {
    const inputs = Array.from(root.querySelectorAll<HTMLInputElement>('input[data-mat]'));
    const rows = Array.from(root.querySelectorAll<HTMLElement>('[data-row]'));
    const counter = root.querySelector<HTMLElement>('[data-counter]');
    const filter = root.querySelector<HTMLInputElement>('[data-filter]');
    const clearBtn = root.querySelector<HTMLButtonElement>('[data-clear]');
    const io = root.querySelector<HTMLTextAreaElement>('[data-io]');
    const ioStatus = root.querySelector<HTMLElement>('[data-io-status]');

    const KEY = (n: string) => `craftcost:price:${n}`;
    const lsGet = (k: string) => {
      try {
        return localStorage.getItem(k) ?? '';
      } catch {
        return '';
      }
    };
    const lsSet = (k: string, v: string) => {
      try {
        if (v === '') localStorage.removeItem(k);
        else localStorage.setItem(k, v);
      } catch {
        /* 記不住就算了 */
      }
    };

    const refreshCount = () => {
      if (!counter) return;
      const filled = inputs.filter((i) => i.value.trim() !== '').length;
      counter.textContent = `已填 ${filled}／${inputs.length} 項`;
    };

    // localStorage 存 1 個的價；輸入框乘回組數顯示、存回時再除掉。
    // 一組幾個每列可調（預設 40），改組數時組價不動、1 個的價跟著重算。
    const DEF_STACK = 40;
    const SKEY = (n: string) => `craftcost:stack:${n}`;
    const numStr = (n: number) => String(Math.round(n * 10000) / 10000);
    const stackInputOf = (input: HTMLInputElement) =>
      input.closest('td')?.querySelector<HTMLInputElement>('input[data-stackinput]');
    const stackOf = (input: HTMLInputElement) => {
      const v = Number.parseInt(stackInputOf(input)?.value ?? '', 10);
      return Number.isFinite(v) && v >= 1 ? v : DEF_STACK;
    };
    const syncPer = (input: HTMLInputElement) => {
      const per = input.closest('td')?.querySelector<HTMLElement>('[data-per]');
      if (!per) return;
      const stack = stackOf(input);
      const v = Number.parseFloat(input.value);
      per.textContent =
        stack > 1 && input.value.trim() !== '' && Number.isFinite(v)
          ? `＝${numStr(v / stack)}／個`
          : '';
    };
    const saveCanon = (input: HTMLInputElement) => {
      const v = Number.parseFloat(input.value);
      lsSet(
        KEY(input.dataset.mat ?? ''),
        input.value.trim() !== '' && Number.isFinite(v) ? numStr(v / stackOf(input)) : '',
      );
    };

    inputs.forEach((input) => {
      const name = input.dataset.mat ?? '';
      const stackInput = stackInputOf(input);
      if (stackInput) {
        const saved = lsGet(SKEY(name));
        if (saved !== '') stackInput.value = saved;
        stackInput.addEventListener('input', () => {
          const v = Number.parseInt(stackInput.value, 10);
          lsSet(SKEY(name), Number.isFinite(v) && v >= 1 && v !== DEF_STACK ? String(v) : '');
          saveCanon(input);
          syncPer(input);
        });
      }
      // NPC 固定售價（1 個的價）當預設；使用者填過的（localStorage）優先
      const canon = lsGet(KEY(name)) || (input.dataset.npc ?? '');
      input.value = canon === '' ? '' : numStr(Number(canon) * stackOf(input));
      syncPer(input);
      input.addEventListener('input', () => {
        saveCanon(input);
        syncPer(input);
        refreshCount();
      });
    });

    filter?.addEventListener('input', () => {
      const q = filter.value.trim();
      rows.forEach((row) => {
        row.hidden = q !== '' && !(row.dataset.name ?? '').includes(q);
      });
    });

    clearBtn?.addEventListener('click', () => {
      if (!confirm(`確定清除全部 ${inputs.length} 項自訂價格與組數？（NPC 固定售價回到預設、一組幾個回到 ${DEF_STACK}）`)) return;
      inputs.forEach((input) => {
        const stackInput = stackInputOf(input);
        if (stackInput) stackInput.value = String(DEF_STACK);
        lsSet(SKEY(input.dataset.mat ?? ''), '');
        const npc = input.dataset.npc;
        input.value = npc != null ? numStr(Number(npc) * DEF_STACK) : '';
        lsSet(KEY(input.dataset.mat ?? ''), '');
        syncPer(input);
      });
      refreshCount();
    });

    root.querySelector('[data-export]')?.addEventListener('click', () => {
      if (!io) return;
      const lines = inputs
        .filter((i) => i.value.trim() !== '')
        .map((i) => `${i.dataset.mat}\t${i.value.trim()}\t${stackOf(i)}`);
      io.value = lines.join('\n');
      io.select();
      // 剪貼簿權限拿不到（舊瀏覽器、非安全來源）就退回框內選取，Ctrl+C 一樣能複製
      const fallback = () =>
        ioStatus && (ioStatus.textContent = `已匯出 ${lines.length} 筆到框內，Ctrl+C 複製`);
      if (navigator.clipboard?.writeText) {
        navigator.clipboard.writeText(io.value).then(
          () => ioStatus && (ioStatus.textContent = `已匯出 ${lines.length} 筆並複製到剪貼簿`),
          fallback,
        );
      } else {
        fallback();
      }
    });

    root.querySelector('[data-import]')?.addEventListener('click', () => {
      if (!io) return;
      const byName = new Map(inputs.map((i) => [i.dataset.mat ?? '', i]));
      let ok = 0;
      let skip = 0;
      for (const line of io.value.split(/\r?\n/)) {
        const m = /^(.+?)[\t=,，:：]\s*([\d.]+)(?:[\t,，]\s*(\d+))?\s*$/.exec(line.trim());
        if (!m) {
          if (line.trim()) skip++;
          continue;
        }
        const input = byName.get(m[1].trim());
        if (!input) {
          skip++;
          continue;
        }
        // 匯入的數字視同表格輸入（組價）；第三欄是一組幾個，沒有就照收方目前的組數
        if (m[3]) {
          const stackInput = stackInputOf(input);
          if (stackInput) stackInput.value = m[3];
          const v = Number.parseInt(m[3], 10);
          lsSet(SKEY(m[1].trim()), Number.isFinite(v) && v >= 1 && v !== DEF_STACK ? m[3] : '');
        }
        input.value = m[2];
        saveCanon(input);
        syncPer(input);
        ok++;
      }
      refreshCount();
      ioStatus && (ioStatus.textContent = `帶入 ${ok} 筆${skip ? `，略過 ${skip} 行` : ''}`);
    });

    refreshCount();
    root.hidden = false;
  });
</script>

<style>
  .mp {
    margin-top: 1.25rem;
  }

  .mp__bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    align-items: center;
    margin-bottom: 0.9rem;
  }

  .mp__bar input[type='search'] {
    font: inherit;
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    width: 14em;
  }

  .mp__count {
    color: var(--text-2);
  }

  .mp__bar button {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: #fff;
    color: var(--text-2);
    cursor: pointer;
    margin-left: auto;
  }

  .mp__bar button:hover {
    background: var(--surface-2);
  }

  .mp__table {
    width: auto;
    min-width: min(30rem, 100%);
    border-collapse: collapse;
  }

  .mp__table th,
  .mp__table td {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border);
    text-align: center;
  }

  .mp__table th {
    background: var(--surface-2);
    font-weight: 600;
  }

  td.mp__name {
    text-align: left;
  }

  .mp__name img {
    height: 24px;
    vertical-align: middle;
    margin-right: 0.4rem;
    image-rendering: pixelated;
  }

  td.mp__price {
    text-align: left;
  }

  .mp__unit {
    font-size: 0.8rem;
    color: var(--text-3);
    margin-left: 0.15rem;
    white-space: nowrap;
  }

  .mp__table input.mp__stackin {
    width: 3em;
    padding: 0.15rem 0.25rem;
    font-size: inherit;
    text-align: center;
  }

  .mp__per {
    display: block;
    font-size: 0.78rem;
    color: var(--text-3);
    margin-top: 0.1rem;
  }

  .mp__table input {
    width: 6.5em;
    font: inherit;
    padding: 0.25rem 0.35rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    text-align: right;
  }

  .mp__io {
    margin-top: 1.1rem;
    max-width: 34rem;
  }

  .mp__io summary {
    cursor: pointer;
    color: var(--text-2);
  }

  .mp__io p {
    font-size: 0.9rem;
    color: var(--text-3);
    margin: 0.5rem 0;
  }

  .mp__io textarea {
    width: 100%;
    font: inherit;
    font-size: 0.9rem;
    padding: 0.45rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    box-sizing: border-box;
  }

  .mp__io-btns {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    margin-top: 0.5rem;
  }

  .mp__io-btns button {
    font: inherit;
    font-size: 0.9rem;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: #fff;
    cursor: pointer;
  }

  .mp__io-btns button:hover {
    background: var(--surface-2);
  }

  .mp__io-status {
    font-size: 0.9rem;
    color: var(--text-2);
  }
</style>
