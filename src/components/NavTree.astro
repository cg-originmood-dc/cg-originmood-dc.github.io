---
import type { NavNode } from '../lib/nav';

/**
 * 側邊導覽。刻意寫成遞迴：原站的分類最深有四層
 * （任務攻略 › 主線任務 › 海底世界系列 › 被抹去的大陸），
 * 寫死幾層的話最底層會變成點不進去的死連結。
 */
interface Props {
  nodes: NavNode[];
  base: string;
  here: string;
  depth?: number;
}
const { nodes, base, here, depth = 0 } = Astro.props;

const isActive = (href: string | null) => href !== null && base + href === here;
const hasActive = (n: NavNode): boolean => isActive(n.href) || n.children.some(hasActive);
---

<ul class="navtree" style={`--depth:${depth}`}>
  {
    nodes.map((n) =>
      n.children.length ? (
        <li>
          {n.href ? (
            <>
              <div class="navtree__row">
                <a href={base + n.href} aria-current={isActive(n.href) ? 'page' : undefined}>
                  {n.label}
                </a>
                <button
                  class="navtree__toggle"
                  type="button"
                  aria-label={`${n.label}子選單`}
                  aria-expanded="true"
                  aria-controls={`nav-children-${encodeURIComponent(base + n.href)}`}
                  data-initial-open={String(hasActive(n))}
                  hidden
                ><span aria-hidden="true">▾</span></button>
              </div>
              <div id={`nav-children-${encodeURIComponent(base + n.href)}`}>
                <Astro.self nodes={n.children} base={base} here={here} depth={depth + 1} />
              </div>
            </>
          ) : (
            <details open={hasActive(n)}>
              <summary>
                <span>{n.label}</span>
              </summary>
              <Astro.self nodes={n.children} base={base} here={here} depth={depth + 1} />
            </details>
          )}
        </li>
      ) : (
        <li>
          <a
            href={n.href ? base + n.href : '#'}
            aria-current={isActive(n.href) ? 'page' : undefined}
          >
            {n.label}
          </a>
        </li>
      ),
    )
  }
</ul>

<script>
  // 標題連結與展開按鈕分開；沒有 JavaScript 時直接顯示子項目。
  document.querySelectorAll<HTMLButtonElement>('.navtree__toggle').forEach((button) => {
    const panel = document.getElementById(button.getAttribute('aria-controls')!);
    if (!panel) return;
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };
    setOpen(button.dataset.initialOpen === 'true');
    button.hidden = false;
    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  });
</script>
