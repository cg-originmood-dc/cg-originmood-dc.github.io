---
/**
 * 生產成本計算機（仿水藍魔力「生產小工具」的一般模式）。
 *
 * 配方不另外抄一份：直接吃本站武器／防具／料理／藥水各 CSV 的材料欄，
 * 那邊修資料這裡自動跟著變。耗魔查 content/data/製作耗魔.csv
 * （技能等級 × 產品階數的矩陣，「-」＝該技能等級做不了）。
 *
 * 材料市價隨伺服器行情浮動，沒有「正確值」可以放資料層，
 * 所以由使用者輸入、記在 localStorage（鍵以材料名共用，
 * 換算別的產品時同一種材料不用重填）。
 *
 * 輸入框收「一組」的價格——礦、木、食材、花材、礦條等市場都照組喊價，
 * 免除心算；一組幾個預設 40（本服最大堆疊），逐項調整在材料價格頁做、
 * 這裡照 craftcost:stack:<材料名> 顯示。localStorage 一律記 1 個的價，
 * 與材料價格頁同鍵互通。
 */
import { loadDataset } from '../lib/datasets';
import { GROUPS, loadProducts, loadNpcPrices } from '../lib/craftCost';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const products = loadProducts();
const npcPrices = loadNpcPrices();

// 耗魔矩陣攤成 mana[技能-1][階數-1]，null＝該技能等級做不了該階
const manaDs = loadDataset('製作耗魔');
const mana = (manaDs?.rows ?? []).map((r) =>
  Array.from({ length: 11 }, (_, i) => {
    const v = (r[`製作${i + 1}`] ?? '').trim();
    return v && v !== '-' ? Number(v) : null;
  }),
);
---

<section
  class="cc"
  data-cc
  data-products={JSON.stringify(products)}
  data-mana={JSON.stringify(mana)}
  data-npc={JSON.stringify(npcPrices)}
  data-item-base={`${base}/道具總覽/`}
  hidden
>
  <div class="cc__pick">
    <label>類別
      <select data-cat>
        {GROUPS.map((g) => (
          <optgroup label={g.label}>
            {g.sets.map((s) => (
              <option value={s}>{s}</option>
            ))}
          </optgroup>
        ))}
      </select>
    </label>
    <label>產品
      <select data-prod></select>
    </label>
    <label title="你自己的製作技能等級，決定耗魔多少；換產品不會動它">技能等級
      <select data-skill>
        {Array.from({ length: 11 }, (_, i) => (
          <option value={i + 1}>{i + 1}</option>
        ))}
      </select>
    </label>
  </div>

  <p class="cc__meta" data-meta></p>

  <table class="cc__table">
    <thead>
      <tr>
        <th>材料</th>
        <th>數量／次</th>
        <th>單價</th>
        <th>小計</th>
        <th>總需求</th>
      </tr>
    </thead>
    <tbody data-mats></tbody>
  </table>

  <p class="cc__hint">
    單價填過會記住。要一次維護全部材料、或匯入別人分享的行情，到
    <a href={`${base}/生產製造/材料價格`}>材料價格</a> 頁。
  </p>

  <div class="cc__pick cc__pick--calc">
    <label title="料理、藥水成品 3 個疊一格、帶滿一身 60 個，預設一次做一身">製作次數
      <input type="number" data-times value="1" min="1" step="1" />
    </label>
    <label>擺攤價／個
      <input type="number" data-sale min="0" step="1" placeholder="自行輸入" />
    </label>
    <label>手續費％
      <input type="number" data-fee value="10" min="0" max="100" step="1" />
    </label>
    <label title="每點耗魔折多少 G（回魔成本），會算進淨利；設 0 就不計">魔力成本／點
      <input type="number" data-manacost value="1" min="0" step="any" />
    </label>
  </div>

  <dl class="cc__out">
    <div><dt>單次材料成本</dt><dd data-o-cost>—</dd></div>
    <div><dt>耗魔</dt><dd data-o-mana>—</dd></div>
    <div><dt>總材料成本</dt><dd data-o-tcost>—</dd></div>
    <div><dt>耗魔費用</dt><dd data-o-manacost>—</dd></div>
    <div><dt>擺攤實收／個</dt><dd data-o-net>—</dd></div>
    <div><dt>單個淨利</dt><dd data-o-profit>—</dd></div>
    <div><dt>總淨利</dt><dd data-o-tprofit>—</dd></div>
  </dl>
</section>
<noscript><p>成本計算機需要開啟 JavaScript 才能使用。</p></noscript>

<script>
  type Mat = [string, number, 0 | 1];
  type Prod = { c: string; l: string; v: number; n: string; s: string; m: Mat[] };

  document.querySelectorAll<HTMLElement>('[data-cc]').forEach((root) => {
    const products: Prod[] = JSON.parse(root.dataset.products ?? '[]');
    const mana: (number | null)[][] = JSON.parse(root.dataset.mana ?? '[]');
    const npc: Record<string, number> = JSON.parse(root.dataset.npc ?? '{}');
    const itemBase = root.dataset.itemBase ?? '';

    const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel);
    const catSel = q<HTMLSelectElement>('[data-cat]');
    const prodSel = q<HTMLSelectElement>('[data-prod]');
    const skillSel = q<HTMLSelectElement>('[data-skill]');
    const timesInput = q<HTMLInputElement>('[data-times]');
    const saleInput = q<HTMLInputElement>('[data-sale]');
    const feeInput = q<HTMLInputElement>('[data-fee]');
    const manaCostInput = q<HTMLInputElement>('[data-manacost]');
    const matsBody = q<HTMLElement>('[data-mats]');
    const meta = q<HTMLElement>('[data-meta]');
    const out = {
      cost: q<HTMLElement>('[data-o-cost]'),
      mana: q<HTMLElement>('[data-o-mana]'),
      tcost: q<HTMLElement>('[data-o-tcost]'),
      manacost: q<HTMLElement>('[data-o-manacost]'),
      net: q<HTMLElement>('[data-o-net]'),
      profit: q<HTMLElement>('[data-o-profit]'),
      tprofit: q<HTMLElement>('[data-o-tprofit]'),
    };
    if (!catSel || !prodSel || !skillSel || !timesInput || !saleInput || !feeInput || !manaCostInput || !matsBody || !meta) return;

    // localStorage 掛了（無痕、隱私設定）也照常能算，只是不記憶
    const lsGet = (k: string) => {
      try {
        return localStorage.getItem(k) ?? '';
      } catch {
        return '';
      }
    };
    const lsSet = (k: string, v: string) => {
      try {
        if (v === '') localStorage.removeItem(k);
        else localStorage.setItem(k, v);
      } catch {
        /* 記不住就算了 */
      }
    };
    const PRICE = (name: string) => `craftcost:price:${name}`;
    const STACK = (name: string) => `craftcost:stack:${name}`;
    const SALE = (name: string) => `craftcost:sale:${name}`;
    const SKILL = (cat: string) => `craftcost:skill:${cat}`;
    const TIMES = (cat: string) => `craftcost:times:${cat}`;
    const FEE = 'craftcost:fee';
    const MANACOST = 'craftcost:manacost';
    // 料理、藥水成品 3 個疊一格、帶滿一身剛好 60 個，預設一次做一身
    const defaultTimes = (cat: string) => (cat === '料理' || cat === '藥水' ? 60 : 1);

    const fmt = (n: number) => n.toLocaleString('zh-Hant', { maximumFractionDigits: 2 });
    // localStorage 存 1 個的價，組價輸入框換算時避免浮點尾數
    const numStr = (n: number) => String(Math.round(n * 10000) / 10000);
    // 一組幾個：預設 40（本服最大堆疊），逐項調整在材料價格頁做
    const stackFor = (name: string) => {
      const v = Number.parseInt(lsGet(STACK(name)), 10);
      return Number.isFinite(v) && v >= 1 ? v : 40;
    };

    let current: Prod | null = null;
    let priceInputs: HTMLInputElement[] = [];
    let subtotalCells: HTMLElement[] = [];
    let totalCells: HTMLElement[] = [];

    const recalc = () => {
      const p = current;
      if (!p) return;
      const times = Math.max(1, Math.trunc(Number(timesInput.value)) || 1);
      const feePct = Math.min(100, Math.max(0, Number(feeInput.value) || 0));

      let cost = 0;
      let missing = 0;
      p.m.forEach(([, qty], i) => {
        // 輸入框收的是一組價，照該列組數（建列時記在 dataset）換回 1 個的價再算
        const stack = Number(priceInputs[i]?.dataset.stack) || 1;
        const price = Number.parseFloat(priceInputs[i]?.value ?? '') / stack;
        if (Number.isFinite(price)) {
          const sub = qty * price;
          cost += sub;
          subtotalCells[i].textContent = fmt(sub);
        } else {
          missing++;
          subtotalCells[i].textContent = '—';
        }
        totalCells[i].textContent = fmt(qty * times);
      });
      const lack = missing ? `（缺 ${missing} 項單價）` : '';

      out.cost && (out.cost.textContent = `${fmt(cost)} G${lack}`);
      out.tcost && (out.tcost.textContent = `${fmt(cost * times)} G${lack}`);

      // 耗魔：矩陣列＝技能等級、欄＝產品階數；12 階是初心自加的品項，原表沒有資料
      const skill = Number(skillSel.value);
      let cellMana: number | null = null;
      let manaNote = '';
      if (p.v > 11) {
        manaNote = '？（12 階品項無耗魔資料）';
      } else {
        const cell = mana[skill - 1]?.[p.v - 1] ?? null;
        if (cell == null) manaNote = `技能 ${skill} 級做不了 ${p.v} 階（需 ${p.v - 1} 級以上）`;
        else cellMana = cell;
      }
      if (out.mana) {
        out.mana.textContent =
          cellMana == null ? manaNote : `${fmt(cellMana)}／次，${times} 次共 ${fmt(cellMana * times)}`;
      }

      // 耗魔折成費用（預設每點 1 G）一併扣進淨利；設 0 就不計
      const manaRate = Number.parseFloat(manaCostInput.value);
      const hasRate = Number.isFinite(manaRate) && manaRate > 0;
      const manaCost = hasRate && cellMana != null ? cellMana * manaRate : null;
      if (out.manacost) {
        out.manacost.textContent = !hasRate
          ? '—（未計）'
          : manaCost == null
            ? '？（無耗魔資料，未計入淨利）'
            : `${fmt(manaCost)} G／次，${times} 次共 ${fmt(manaCost * times)} G`;
      }

      const sale = Number.parseFloat(saleInput.value);
      if (!Number.isFinite(sale) || sale <= 0) {
        out.net && (out.net.textContent = '—（未填擺攤價）');
        out.profit && (out.profit.textContent = '—');
        out.tprofit && (out.tprofit.textContent = '—');
        return;
      }
      const net = sale - Math.floor((sale * feePct) / 100);
      const profit = net - cost - (manaCost ?? 0);
      const noteHint = lack + (hasRate && manaCost == null ? '（耗魔費用未計）' : '');
      out.net && (out.net.textContent = `${fmt(net)} G（手續費 ${fmt(sale - net)}）`);
      const mark = (el: HTMLElement | null, value: number, suffix: string) => {
        if (!el) return;
        el.textContent = `${fmt(value)} G${suffix}`;
        el.classList.toggle('is-neg', value < 0);
      };
      mark(out.profit, profit, noteHint);
      mark(out.tprofit, profit * times, noteHint);
    };

    /** 換產品：重建材料列、帶回記過的單價與擺攤價（技能等級不動，見 applySkillDefaults） */
    const showProduct = (p: Prod) => {
      current = p;
      priceInputs = [];
      subtotalCells = [];
      totalCells = [];
      matsBody.textContent = '';
      p.m.forEach(([name, qty, linkable]) => {
        const stack = stackFor(name);
        const tr = document.createElement('tr');
        const nameTd = document.createElement('td');
        nameTd.className = 'cc__mat-name';
        if (linkable) {
          const a = document.createElement('a');
          a.href = itemBase + encodeURIComponent(name);
          a.textContent = name;
          nameTd.append(a);
        } else {
          nameTd.textContent = name;
        }
        const qtyTd = document.createElement('td');
        qtyTd.textContent = String(qty);
        const priceTd = document.createElement('td');
        const input = document.createElement('input');
        input.type = 'number';
        input.min = '0';
        input.step = 'any';
        // NPC 固定販售的材料（布料）自動帶售價當預設成本；使用者填過的市價優先。
        // 記的一律是 1 個的價，輸入框乘回組數顯示組價。
        input.dataset.stack = String(stack);
        const canon = lsGet(PRICE(name)) || (npc[name] != null ? String(npc[name]) : '');
        input.value = canon === '' ? '' : numStr(Number(canon) * stack);
        const tip: string[] = [];
        if (stack > 1) tip.push(`填一組（${stack} 個）的價格，一組幾個可到材料價格頁調整`);
        if (npc[name] != null) tip.push(`NPC 固定售價 ${npc[name]} G／個，可自行覆寫`);
        if (tip.length) input.title = tip.join('；');
        input.addEventListener('input', () => {
          const v = Number.parseFloat(input.value);
          lsSet(PRICE(name), input.value.trim() !== '' && Number.isFinite(v) ? numStr(v / stack) : '');
          recalc();
        });
        const unit = document.createElement('small');
        unit.className = 'cc__unit';
        unit.textContent = stack > 1 ? `／組(${stack}個)` : '／個';
        priceTd.append(input, unit);
        const subTd = document.createElement('td');
        const totalTd = document.createElement('td');
        priceInputs.push(input);
        subtotalCells.push(subTd);
        totalCells.push(totalTd);
        tr.append(nameTd, qtyTd, priceTd, subTd, totalTd);
        matsBody.append(tr);
      });
      saleInput.value = lsGet(SALE(p.n));
      meta.textContent = `${p.c}　${p.l} 階「${p.n}」｜販店價：${p.s || '—'}`;
      recalc();
    };

    /**
     * 技能等級與製作次數是「玩家」的設定，不是產品的屬性——換產品時不能動它。
     * 之前換產品會把技能等級重設成該產品的階數，於是選 8 階螃蟹鍋就變成
     * 「技能 8 級」，耗魔顯示 103；實際滿等 11 級做同一道是 79，數字看起來
     * 就是錯的。選過會記住（每種製作技能分開記），沒記過用滿等 11。
     */
    const applySkillDefaults = (cat: string) => {
      const savedSkill = lsGet(SKILL(cat));
      skillSel.value = savedSkill !== '' ? savedSkill : '11';
      const savedTimes = lsGet(TIMES(cat));
      timesInput.value = savedTimes !== '' ? savedTimes : String(defaultTimes(cat));
    };

    const fillProducts = () => {
      const list = products.filter((p) => p.c === catSel.value);
      prodSel.textContent = '';
      list.forEach((p, i) => {
        const opt = document.createElement('option');
        opt.value = String(i);
        opt.textContent = `${p.l}　${p.n}`;
        prodSel.append(opt);
      });
      applySkillDefaults(catSel.value);
      if (list.length) showProduct(list[0]);
    };

    catSel.addEventListener('change', fillProducts);
    prodSel.addEventListener('change', () => {
      const list = products.filter((p) => p.c === catSel.value);
      const p = list[Number(prodSel.value)];
      if (p) showProduct(p);
    });
    skillSel.addEventListener('change', () => {
      lsSet(SKILL(catSel.value), skillSel.value);
      recalc();
    });
    timesInput.addEventListener('input', () => {
      lsSet(TIMES(catSel.value), timesInput.value.trim());
      recalc();
    });
    feeInput.addEventListener('input', () => {
      lsSet(FEE, feeInput.value.trim());
      recalc();
    });
    manaCostInput.addEventListener('input', () => {
      lsSet(MANACOST, manaCostInput.value.trim());
      recalc();
    });
    saleInput.addEventListener('input', () => {
      if (current) lsSet(SALE(current.n), saleInput.value.trim());
      recalc();
    });

    const savedFee = lsGet(FEE);
    if (savedFee !== '') feeInput.value = savedFee;
    const savedManaCost = lsGet(MANACOST);
    if (savedManaCost !== '') manaCostInput.value = savedManaCost;
    catSel.value = '料理';
    fillProducts();
    root.hidden = false;
  });
</script>

<style>
  .cc {
    margin-top: 1.25rem;
  }

  .cc__pick {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.25rem;
    align-items: center;
    margin-bottom: 0.9rem;
  }

  .cc__pick--calc {
    margin-top: 1rem;
  }

  .cc__pick label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-2);
    white-space: nowrap;
  }

  .cc__pick select,
  .cc__pick input {
    font: inherit;
    padding: 0.3rem 0.45rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: #fff;
    color: var(--text);
  }

  .cc__pick input {
    width: 6.5em;
  }

  .cc__meta {
    margin: 0 0 0.6rem;
    color: var(--text-2);
  }

  .cc__hint {
    margin: 0.6rem 0 0;
    font-size: 0.9rem;
    color: var(--text-3);
  }

  /* 材料列由 JS 動態長出來，樣式要走 :global 才掛得到 */
  :global(.cc__table) {
    width: auto;
    min-width: min(34rem, 100%);
    border-collapse: collapse;
  }

  :global(.cc__table th),
  :global(.cc__table td) {
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--border);
    text-align: center;
  }

  :global(.cc__table th) {
    background: var(--surface-2);
    font-weight: 600;
  }

  :global(.cc__table td.cc__mat-name) {
    text-align: left;
  }

  :global(.cc__table td input) {
    width: 6em;
    font: inherit;
    padding: 0.25rem 0.35rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    text-align: right;
  }

  :global(.cc__table .cc__unit) {
    font-size: 0.8rem;
    color: var(--text-3);
    margin-left: 0.15rem;
    white-space: nowrap;
  }

  .cc__out {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 0.5rem 1.5rem;
    margin: 1rem 0 0;
    max-width: 40rem;
  }

  .cc__out > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px dashed var(--border);
    padding-bottom: 0.3rem;
  }

  .cc__out dt {
    color: var(--text-2);
  }

  .cc__out dd {
    margin: 0;
    font-weight: 600;
  }

  :global(.cc__out dd.is-neg) {
    color: #b42318;
  }

  @media (max-width: 700px) {
    .cc__pick {
      gap: 0.5rem 0.9rem;
    }
  }
</style>
