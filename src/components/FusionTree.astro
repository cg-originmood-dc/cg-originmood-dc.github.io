---
/**
 * 合成樹（由頂點向下解構）
 * - 單產物：一個頭 → 材料
 * - 多產物：多個頭並列 → 共用材料（多拉線）
 * - 互轉循環：以寵物／道具實體節點和不可見的反應匯合位置組成有向圖。
 */
import type {
  FusionCycleGraphNode,
  FusionCycleGraphReaction,
  FusionNode,
} from '../lib/pets';
import FusionNodeCard from './FusionNodeCard.astro';

interface Props {
  node: FusionNode;
  base?: string;
  depth?: number;
  /** 目前瀏覽的寵物名稱，用於高亮 */
  currentName?: string;
}

interface GraphPoint {
  x: number;
  y: number;
}

const { node, base = '', depth = 0, currentName = '' } = Astro.props;
const cycle = node.cycleModule;
const isCycleModule = Boolean(cycle);
const isMultiHead = !isCycleModule && Boolean(node.heads && node.heads.length > 1);
const isForestRoot =
  !isCycleModule &&
  !isMultiHead &&
  !node.name &&
  node.type === 'material' &&
  Boolean(node.children?.length);
const isRoot = depth === 0 || !!node.target;

function spread(count: number, start: number, end: number): number[] {
  if (count <= 0) return [];
  if (count === 1) return [(start + end) / 2];
  return Array.from({ length: count }, (_, index) => {
    return start + ((end - start) * index) / (count - 1);
  });
}

function graphLayout(graph: {
  nodes: FusionCycleGraphNode[];
  reactions: FusionCycleGraphReaction[];
}): { positions: Map<string, GraphPoint>; junctions: Map<string, GraphPoint> } {
  const positions = new Map<string, GraphPoint>();
  const junctions = new Map<string, GraphPoint>();
  const nodeById = new Map(graph.nodes.map((graphNode) => [graphNode.id, graphNode]));
  const hub = graph.reactions.find((reaction) => reaction.outputs.length > 1) ?? graph.reactions[0];
  const rest = hub ? graph.reactions.filter((reaction) => reaction.id !== hub.id) : [];

  const put = (id: string, x: number, y: number) => positions.set(id, { x, y });
  const nodeName = (id: string) => nodeById.get(id)?.node.name ?? '';

  if (hub) {
    const sourceIds = hub.inputs.map((input) => input.nodeId);
    const sourceYs = spread(sourceIds.length, 23, 39);
    sourceIds.forEach((id, index) => put(id, 13, sourceYs[index]!));

    const hubOutputIds = hub.outputs.map((output) => output.nodeId);
    const hubInputPetNames = new Set(
      sourceIds
        .map((id) => nodeById.get(id))
        .filter((graphNode) => graphNode?.node.type === 'pet')
        .map((graphNode) => graphNode!.node.name),
    );
    const selfOutputIds = hubOutputIds.filter((id) => hubInputPetNames.has(nodeName(id)));
    const otherOutputIds = hubOutputIds.filter((id) => !selfOutputIds.includes(id));
    const outputOrder = [...otherOutputIds.slice(0, 1), ...selfOutputIds, ...otherOutputIds.slice(1)];
    const outputYs = spread(outputOrder.length, 12, 50);
    outputOrder.forEach((id, index) => put(id, 54, outputYs[index]!));

    const restInputIds = rest.flatMap((reaction) => reaction.inputs.map((input) => input.nodeId));
    const sharedIds = [...new Set(restInputIds)].filter((id) => !hubOutputIds.includes(id));
    const sharedYs = spread(sharedIds.length, 72, 86);
    sharedIds.forEach((id, index) => put(id, 34, sharedYs[index]!));

    // 讓後續反應依其上游產物的垂直位置排列，避免兩條回流線彼此交叉。
    const averageInputY = (reaction: FusionCycleGraphReaction): number => {
      const ys = reaction.inputs
        .map((input) => positions.get(input.nodeId)?.y)
        .filter((y): y is number => y != null);
      return ys.length ? ys.reduce((sum, value) => sum + value, 0) / ys.length : 50;
    };
    const orderedRest = [...rest].sort((a, b) => averageInputY(a) - averageInputY(b));
    const restOutputIds = orderedRest.flatMap((reaction) =>
      reaction.outputs.map((output) => output.nodeId),
    );
    const returnYs = spread(restOutputIds.length, 66, 90);
    restOutputIds.forEach((id, index) => put(id, 86, returnYs[index]!));

    junctions.set(hub.id, { x: 36, y: 29 });
    orderedRest.forEach((reaction) => {
      const outputY = reaction.outputs
        .map((output) => positions.get(output.nodeId)?.y)
        .filter((y): y is number => y != null);
      const inputY = reaction.inputs
        .map((input) => positions.get(input.nodeId)?.y)
        .filter((y): y is number => y != null);
      const ys = outputY.length ? outputY : inputY;
      const y = ys.length ? ys.reduce((sum, value) => sum + value, 0) / ys.length : 50;
      junctions.set(reaction.id, { x: 68, y });
    });
  }

  // 非典型循環仍保留所有節點與匯合位置，不讓任何節點變成孤立項目。
  const unplaced = graph.nodes.filter((graphNode) => !positions.has(graphNode.id));
  const unplacedYs = spread(unplaced.length, 18, 82);
  unplaced.forEach((graphNode, index) => put(graphNode.id, 50, unplacedYs[index]!));
  const unplacedReactions = graph.reactions.filter((reaction) => !junctions.has(reaction.id));
  const reactionYs = spread(unplacedReactions.length, 18, 82);
  unplacedReactions.forEach((reaction, index) => {
    junctions.set(reaction.id, { x: 68, y: reactionYs[index]! });
  });

  return { positions, junctions };
}

const layout = cycle ? graphLayout(cycle.graph) : null;
const focused = cycle?.focusedPet || currentName;
const focusedNodeId = cycle
  ? cycle.graph.nodes.find(
      (graphNode) => graphNode.node.type === 'pet' && graphNode.node.name === focused,
    )?.id
  : undefined;

---

{
  isCycleModule && cycle && layout ? (
    <li class="tree-cycle-module" data-cycle-id={cycle.id}>
      <div class="cycle-graph-scroll">
        <div class="cycle-graph" data-cycle-graph data-cycle-id={cycle.id}>
          <svg class="cycle-graph__edges" data-cycle-edges aria-hidden="true" focusable="false">
            {
              cycle.graph.reactions.map((reaction, reactionIndex) => {
                const junction = layout.junctions.get(reaction.id)!;
                // 後續反應的輸入來自右側產物卡，匯合線要留在卡片右側，不能穿過卡片。
                const inputLane =
                  reactionIndex === 0
                    ? Math.max(4, junction.x - 5)
                    : Math.max(4, junction.x - 3 - (reactionIndex - 1) * 1.5);
                const outputLane = Math.min(
                  96,
                  junction.x + (reactionIndex === 0 ? 5 : 5 + reactionIndex * 4),
                );
                return (
                  <>
                    {reaction.inputs.map((input, index) => (
                      <path
                        class="cycle-graph__edge cycle-graph__edge--input"
                        data-cycle-path={`${reaction.id}:input:${index}`}
                        data-cycle-from={input.nodeId}
                        data-cycle-role="input"
                        data-cycle-junction-x={junction.x}
                        data-cycle-junction-y={junction.y}
                        data-cycle-route-x={inputLane}
                      />
                    ))}
                    {reaction.outputs.map((output, index) => (
                      <path
                        class="cycle-graph__edge cycle-graph__edge--output"
                        data-cycle-path={`${reaction.id}:output:${index}`}
                        data-cycle-to={output.nodeId}
                        data-cycle-role="output"
                        data-cycle-junction-x={junction.x}
                        data-cycle-junction-y={junction.y}
                        data-cycle-route-x={outputLane}
                      />
                    ))}
                  </>
                );
              })
            }
          </svg>

          <div class="cycle-graph__nodes">
            {cycle.graph.nodes.map((graphNode) => {
              const point = layout.positions.get(graphNode.id)!;
              return (
                <div
                  class="cycle-graph__node"
                  data-cycle-node={graphNode.id}
                  style={`left: ${point.x}%; top: ${point.y}%;`}
                >
                  <FusionNodeCard
                    node={graphNode.node}
                    base={base}
                    currentName=""
                    isCurrent={graphNode.id === focusedNodeId}
                  />
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </li>
  ) : isMultiHead ? (
    <li class:list={['tree-multi-head', { 'tree-multi-head--root': isRoot }]}>
      <div class="tree-multi-head__tops">
        <ul class="tree-multi-head__heads">
          {
            node.heads!.map((head) => (
              <li class="tree-multi-head__head">
                <FusionNodeCard
                  node={head}
                  base={base}
                  currentName={currentName}
                  isTarget={isRoot}
                />
              </li>
            ))
          }
        </ul>
      </div>
      {
        node.children && node.children.length > 0 && (
          <ul class="tree-children">
            {node.children.map((child) => (
              <Astro.self
                node={child}
                base={base}
                depth={depth + 1}
                currentName={currentName}
              />
            ))}
          </ul>
        )
      }
    </li>
  ) : isForestRoot ? (
    <li class="tree-forest-root">
      <ul class="tree-children tree-children--forest">
        {
          node.children!.map((child) => (
            <Astro.self
              node={child}
              base={base}
              depth={depth}
              currentName={currentName}
            />
          ))
        }
      </ul>
    </li>
  ) : (
    <li class="tree-node">
      <FusionNodeCard
        node={node}
        base={base}
        currentName={currentName}
        isTarget={isRoot}
      />
      {
        node.children && node.children.length > 0 && (
          <ul class="tree-children">
            {node.children.map((child) => (
              <Astro.self
                node={child}
                base={base}
                depth={depth + 1}
                currentName={currentName}
              />
            ))}
          </ul>
        )
      }
    </li>
  )
}

<style is:global>
  .cycle-graph-scroll {
    width: 100%;
    overflow-x: auto;
    border: 1px solid #dfd6ce;
    border-radius: 10px;
    background:
      linear-gradient(rgba(245, 239, 233, 0.46) 1px, transparent 1px),
      linear-gradient(90deg, rgba(245, 239, 233, 0.46) 1px, transparent 1px),
      #fffdfa;
    background-size: 28px 28px;
    scrollbar-gutter: stable;
  }
  .cycle-graph {
    position: relative;
    width: 100%;
    min-width: 900px;
    min-height: 760px;
    overflow: hidden;
  }
  .cycle-graph__edges,
  .cycle-graph__nodes {
    position: absolute;
    inset: 0;
  }
  .cycle-graph__edges {
    z-index: 1;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .cycle-graph__edge {
    fill: none;
    stroke-width: 2.2;
    stroke: #e65100;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }
  .cycle-graph__edge--input {
    stroke: #e65100;
  }
  .cycle-graph__nodes {
    z-index: 2;
  }
  .cycle-graph__node {
    position: absolute;
    z-index: 3;
    width: 168px;
    transform: translate(-50%, -50%);
  }
  @media (max-width: 700px) {
    .cycle-graph {
      min-height: 700px;
    }
    .cycle-graph__node {
      width: 168px;
    }
  }
</style>
