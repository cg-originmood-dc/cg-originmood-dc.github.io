---
/**
 * 推薦練功攻略頁的內容，分兩塊：
 *
 * 1. 推薦路線 —— 路線名稱由 content/data/練功路線.csv 定義，
 *    地點屬於哪些路線寫在地點列表的「路線」欄（一列可屬多條路線）。
 *    選一條路線就把下方列表篩成該路線的點。
 * 2. 練功地圖列表 —— 全部地點，另有分區按鈕。兩組篩選可同時作用。
 *
 * 地點只有一份定義（練功地點列表.csv），路線不複製地點資料，只用標籤關聯；
 * 之後新增路線就加一列 練功路線.csv、在地點的「路線」欄補上名稱，畫面不用改。
 */
import { LIST_SEP, loadDataset } from '../lib/datasets';
import { renderCell } from '../lib/richtext';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rows = loadDataset('練功地點列表')?.rows ?? [];
const routeRows = loadDataset('練功路線')?.rows ?? [];

/**
 * 有玩家指出資料需要修正時（例如怪物名稱、建議水晶），直接改掉表格內容，
 * 但改了什麼、誰提供的，記在這份獨立的更新記錄裡，列在頁尾——
 * 修正不會憑空消失在 git log 裡，讀者也看得到是誰幫忙校正的。
 */
/**
 * 等級差（玩家 − 怪物）對經驗百分比的對照表。「適合等級」的推算基準
 * 就是這張表的 ≥80% 區間（-5～+6），放在頁尾供讀者查證與自行推算。
 * 滿額（100%）與 80% 以上的列由數值推導上色，不另存標記。
 */
const expRows = (loadDataset('等級差經驗')?.rows ?? []).map((r) => {
  const pct = Number((r['經驗百分比'] ?? '').trim());
  return {
    diff: (r['等級差'] ?? '').trim(),
    pct,
    note: (r['備註'] ?? '').trim(),
    full: pct === 100,
    good: pct >= 80 && pct < 100,
  };
});

const changelog = (loadDataset('練功地點列表-更新記錄')?.rows ?? []).map((r) => ({
  date: (r['日期'] ?? '').trim(),
  place: (r['地點'] ?? '').trim(),
  field: (r['欄位'] ?? '').trim(),
  change: (r['異動'] ?? '').trim(),
  by: (r['提供者'] ?? '').trim(),
}));

/**
 * 進入條件的類型表：一種條件一筆設定，畫面需要知道的事都在這裡。
 *
 * 這張表是「錦上添花」用的，不是規格檢查：
 * 進入條件欄本來就允許直接寫白話（「需 S 階且角色滿 100 級」「A 或 B 擇一」），
 * 那些照樣會完整顯示，只是沒有句型、沒有顏色、排在有登記的條件後面。
 * 補資料的玩家不需要知道有類型這回事，寫得出來就會出現在頁面上。
 *
 * 有登記的類型多做三件事：值只存純值（任務欄寫「二等勳章」不是「解完二等
 * 勳章」、時段欄寫「夜間」不是「僅限夜間」），由 phrase 統一套句型、給顏色、
 * 給固定排序——好處是同類條件全站講法一致，改講法也只改這裡一處。
 *
 * 要讓某種條件享有這些待遇，在這裡加一筆即可（例如
 * `隊伍: { order: 5, phrase: (v) => `隊伍 ${v}`, color: '#00838f' }`），
 * 句型、顏色、排序、標籤長度上限會同時生效，不必再去別處補登記。
 *
 * order 的邏輯：角色自身條件（等級→階級→稱號）→ 事前準備（任務→物品）
 * → 到場相關（時段→傳送限制→費用→密語）。資料層不用管儲存順序，這裡排。
 * color 留空＝用預設文字色；等級／階級因為最常出現，用低飽和色不搶戲。
 */
interface CondType {
  order: number;
  phrase: (value: string) => string;
  color: string;
}

const COND_TYPES: Record<string, CondType> = {
  等級: { order: 0, phrase: (v) => `等級 ${v}`, color: '#9d5c5c' },
  階級: { order: 1, phrase: (v) => `${v} 階級`, color: '#5c6494' },
  稱號: { order: 2, phrase: (v) => `擁有 ${v} 稱號`, color: '#6a1b9a' },
  任務: { order: 3, phrase: (v) => `需完成 ${v}`, color: '#0d47a1' },
  物品: { order: 4, phrase: (v) => `持有 ${v}`, color: '#1b5e20' },
  時段: { order: 5, phrase: (v) => `${v}時段`, color: '#8d6e00' },
  傳送限制: { order: 6, phrase: (v) => `傳送限制 ${v}`, color: '' },
  費用: { order: 7, phrase: (v) => v, color: '#8d6e00' },
  密語: { order: 8, phrase: (v) => `密語「${v}」`, color: '#00695c' },
  職業: { order: 9, phrase: (v) => `${v} 職業`, color: '' },
};

/**
 * 沒登記在上表的條件（白話敘述、擇一條件、還沒登記的新標籤）共用這組：
 * 原樣完整顯示、排在最後、不上色。資料一定看得到，只是少了那三項加工。
 */
const COND_FALLBACK: CondType = { order: 99, phrase: (v) => v, color: '' };

/** 標籤最長幾個字——由表上最長的 key 決定，加新標籤不用回頭改這裡 */
const COND_LABEL_MAX = Math.max(...Object.keys(COND_TYPES).map((k) => k.length));

const split = (v: string) => v.split(LIST_SEP).map((s) => s.trim()).filter(Boolean);

const spots = rows.map((r) => {
  const get = (k: string) => (r[k] ?? '').trim();
  return {
    zone: get('分區'),
    routes: split(get('路線')),
    fitLv: get('適合等級'),
    mark: get('標記'),
    place: get('地點'),
    sub: get('副標'),
    abbr: get('簡稱'),
    mobs: get('怪物'),
    mobLv: get('怪物等級'),
    // 練技點是拿來練技能熟練度的，不是練經驗——這欄放的是「帶去練技的角色等級」，
    // 跟左側徽章的「適合等級」（練經驗用）意義不同，只有練技點才有值，其餘留空。
    skillLv: get('練技等級'),
    mobCount: get('一次幾隻'),
    crystals: split(get('建議水晶')),
    notes: split(get('註')),
    route: get('怎麼去'),
    conds: get('進入條件')
      .split(/；|;/)
      .map((s) => s.trim())
      .filter(Boolean)
      .map((part) => {
        const m = part.match(new RegExp(`^([^：]{1,${COND_LABEL_MAX}})：(.+)$`));
        const type = m ? COND_TYPES[m[1]] : undefined;
        // 認得的標籤才拆掉冒號套句型；認不得就整段原樣顯示
        const text = type ? type.phrase(m![2].trim()) : COND_FALLBACK.phrase(part);
        return { ...(type ?? COND_FALLBACK), html: renderCell(text, base) };
      })
      .sort((a, b) => a.order - b.order),
  };
});

/** 路線：名稱與順序由 練功路線.csv 決定；有無地點由各地點的「路線」欄算出來 */
const routes = routeRows
  .map((r) => ({
    name: (r['路線'] ?? '').trim(),
    note: (r['說明'] ?? '').trim(),
  }))
  .filter((r) => r.name)
  .map((r) => ({ ...r, empty: !spots.some((s) => s.routes.includes(r.name)) }));

/**
 * 分區：順序固定，六區各用不同色系（綠→青→藍→紫→棕→桃）。
 * 每個色都做過白字對比檢查（全部 ≥5:1），徽章用實心色配白字。
 *
 * 注意：綠↔青、藍↔紫這兩組在這個明度下先天接近（色盲模擬 ΔE 6–8），
 * 單靠顏色不足以辨識。所以每一區都必須保留文字標題（新手區／低等區…），
 * 徽章本身也帶等級數字——顏色只是輔助，不是唯一線索。要拿掉標題前請三思。
 *
 * 練技區是特例：不是照等級分層，是「練技能熟練度」這個用途獨立成一區，
 * 放在最後——裡面每筆地點的等級徽章是各自的技能經驗上限，差距很大
 * （≤40 到 ≤98 都有），所以標題不寫等級區間，而是解釋徽章代表什麼。
 *
 * range 是篩選按鈕上的短標（空間小），caption 是分區標題的說明（可長一點）；
 * 一般分區的 caption 就是「Lv ＋ 區間」，練技區則是講技能經驗的規則。
 */
const ZONE_ORDER = ['新手區', '低等區', '中等區', '高等區', '高手區', '練技區'];
type ZoneMeta = { range: string; caption: string; deep: string; tint: string; ink: string };
const ZONE_META: Record<string, ZoneMeta> = {
  新手區: { range: '1–20', caption: 'Lv 1–20', deep: '#2e7d32', tint: '#f7f8f7', ink: '#2e7d32' },
  低等區: { range: '20–50', caption: 'Lv 20–50', deep: '#00796b', tint: '#f6f8f8', ink: '#00695c' },
  中等區: { range: '50–70', caption: 'Lv 50–70', deep: '#1565c0', tint: '#f6f8fa', ink: '#1565c0' },
  高等區: { range: '70–90', caption: 'Lv 70–90', deep: '#7b1fa2', tint: '#f9f7fa', ink: '#7b1fa2' },
  高手區: { range: '90 以上', caption: 'Lv 90 以上', deep: '#8d4a26', tint: '#faf8f6', ink: '#8d4a26' },
  練技區: {
    range: '練技',
    caption: '角色等級在標示值以內才有技能經驗（怪物等級 = 角色等級 ÷ 2 − 3）',
    deep: '#ad1457',
    tint: '#fdf6f9',
    ink: '#ad1457',
  },
};
const zones = ZONE_ORDER.filter((z) => spots.some((s) => s.zone === z)).map((z) => ({
  name: z,
  ...ZONE_META[z],
}));

/**
 * 各地點的「來源」欄記著這筆資料抄自哪篇文章／wiki 頁（Markdown 連結，多筆用
 * LIST_SEP 分隔）。這裡把全表的連結收集起來去重，整理成頁尾的來源清單，
 * 不用每一列都重複列一次出處。
 */
const MD_LINK = /^\[([^\]]+)\]\(([^)\s]+)\)$/;
const sourceLinks = new Map<string, string>();
for (const r of rows) {
  for (const part of split((r['來源'] ?? '').trim())) {
    const m = part.match(MD_LINK);
    if (m && !sourceLinks.has(m[2])) sourceLinks.set(m[2], m[1]);
  }
}
const sources = [...sourceLinks].map(([href, text]) => ({ href, text }));
---

<div class="lv" data-lv-root>
  <!-- 第一塊：推薦路線 -->
  <div class="lv__routes" role="group" aria-label="選擇推薦路線">
    <button type="button" class="lv__route is-active" data-route="">全部路線</button>
    {routes.map((r) => (
      <button
        type="button"
        class:list={['lv__route', { 'is-empty': r.empty }]}
        data-route={r.name}
        title={r.note || undefined}
      >
        {r.name}
        {r.empty && <small>待補</small>}
      </button>
    ))}
  </div>

  <!-- 第二塊：練功地圖列表 -->
  <h2 class="lv__heading">練功地圖列表</h2>

  {/* 分區按鈕會依上面選的路線收起沒東西的區 */}
  <div class="lv__zones" role="group" aria-label="依分區篩選">
    <button type="button" class="lv__zone is-active" data-zone="">全部</button>
    {zones.map((z) => (
      <button type="button" class="lv__zone" data-zone={z.name} style={`--zone-deep:${z.deep}`}>
        {z.name}
        <small>{z.range}</small>
      </button>
    ))}
  </div>

  <p class="lv__count" data-lv-count>{spots.length} 處</p>

  {/* 篩到沒東西時要說明原因，不然畫面整片空白會被當成壞掉 */}
  <p class="lv__none" data-lv-none hidden></p>

  {zones.map((zone) => (
    <section
      class="lv__section"
      data-zone-section={zone.name}
      style={`--zone-deep:${zone.deep};--zone-tint:${zone.tint};--zone-ink:${zone.ink}`}
    >
      <h3 class="lv__zonehead">
        {zone.name} <span>{zone.caption}</span>
      </h3>

      {spots
        .filter((s) => s.zone === zone.name)
        .map((spot) => (
          // 所屬路線只作為篩選用的資料屬性（data-routes），不顯示在列上
          <div class="lv__row" data-routes={spot.routes.join(',')} data-row-zone={spot.zone}>
            {/* 左欄的等級徽章：練功點顯示「適合等級」，練技點顯示「練技等級」
                （兩欄互斥、永遠只有一欄有值），都沒有就維持 -。
                練技等級存的是保守上限（=(最低怪+3)×2，在此等級內每隻怪都給
                技能經驗），顯示成 ≤ N；再往上會逐隻失效，細節寫在明細行。 */}
            {spot.skillLv ? (
              // 徽章底色吃所在分區的 --zone-deep（練技區是桃紅），不必另設樣式
              <span class="lv__lv">≤ {spot.skillLv}</span>
            ) : (
              <span class:list={['lv__lv', { 'lv__lv--todo': !spot.fitLv || spot.fitLv === '-' }]}>
                {spot.fitLv || '待補'}
              </span>
            )}

            <div class="lv__name">
              <span class="lv__place">{spot.place}</span>
              {spot.sub && <span class="lv__sub">（{spot.sub}）</span>}
              {spot.abbr && <span class="lv__abbr">{spot.abbr}</span>}
              {spot.mark && <span class="lv__mark">{spot.mark}</span>}
            </div>

            <div class="lv__detail">
              {spot.mobs && <p class="lv__mobs">{spot.mobs}</p>}
              {/* 缺值填「待補」的欄位不能硬套「怪 ＿ 等」「一次 ＿ 隻」句型，
                  會渲染成「一次 待補 隻」這種怪句，改寫成「數量待補」等文案 */}
              {(spot.mobLv || spot.mobCount) && (
                <p class="lv__line">
                  {spot.mobLv &&
                    (spot.mobLv === '待補' ? <span>等級待補</span> : <span>怪 {spot.mobLv} 等</span>)}
                  {spot.mobCount &&
                    (spot.mobCount === '待補' ? (
                      <span>數量待補</span>
                    ) : (
                      <span>一次 {spot.mobCount} 隻</span>
                    ))}
                </p>
              )}
              {spot.notes.map((n) => (
                <p class="lv__note">
                  <span class="lv__notekey">註</span>
                  <span set:html={renderCell(n, base)} />
                </p>
              ))}
            </div>

            <div class="lv__extra">
              <div class="lv__crystals">
                {/* 「待補」不是一種水晶，不能渲染成水晶 chip，用灰字顯示 */}
                {spot.crystals.length === 0 ? (
                  <span class="lv__blank">—</span>
                ) : spot.crystals.length === 1 && spot.crystals[0] === '待補' ? (
                  <span class="lv__blank">待補</span>
                ) : (
                  spot.crystals.map((c) => <span class="lv__crystal">{c}</span>)
                )}
              </div>

              <div class="lv__side">
                <p class="lv__line">
                  <span class="lv__key">怎麼去</span>
                  {spot.route === '待補' || !spot.route ? (
                    <span class="lv__todo">待補</span>
                  ) : (
                    <span set:html={renderCell(spot.route, base)} />
                  )}
                </p>
                {/* 條件用句子呈現，不用「標籤＋徽章」；顏色由 COND_TYPES 決定，
                    留空就吃 .lv__condtext 的預設文字色 */}
                {spot.conds.map((cond) => (
                  <p class="lv__cond">
                    <span
                      class="lv__condtext"
                      style={cond.color ? `color:${cond.color}` : undefined}
                      set:html={cond.html}
                    />
                  </p>
                ))}
              </div>
            </div>
          </div>
        ))}
    </section>
  ))}

  {expRows.length > 0 && (
    <details
      class="lv__exp"
      data-exp-root
      data-exp={JSON.stringify(Object.fromEntries(expRows.map((r) => [r.diff, r.pct])))}
    >
      <summary>等級差經驗對照（適合等級的推算基準）</summary>
      <div class="lv__exp-slider">
        <label for="lv-exp-level">你的等級</label>
        <input id="lv-exp-level" type="range" min="5" max="140" value="20" data-exp-slider />
        <b data-exp-level>Lv.20</b>
      </div>
      <p class="lv__exp-note">怪物由強到弱排：</p>
      <div class="lv__exp-tiers" data-exp-tiers></div>
      <p class="lv__exp-foot">
        最佳區永遠是「你的等級 ～ 你的等級＋5」。每差 1 等經驗變動 3.33%，更遠依同規則遞減。
      </p>
    </details>
  )}

  {sources.length > 0 && (
    <aside class="lv__sources">
      <span class="lv__sources-label">資料來源</span>
      <ul class="lv__sources-list">
        {sources.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener noreferrer">
              {s.text}
            </a>
          </li>
        ))}
      </ul>
      <span class="lv__sources-hint">部分地點資料整理自外部文章／wiki，與永恆初心現況可能有出入</span>
    </aside>
  )}

  {changelog.length > 0 && (
    <aside class="lv__changelog">
      <span class="lv__changelog-label">歷史更新</span>
      <ul class="lv__changelog-list">
        {changelog.map((c) => (
          <li>
            <span class="lv__changelog-date">{c.date}</span>
            <span class="lv__changelog-place">{c.place}</span>
            <span class="lv__changelog-field">{c.field}</span>
            <span class="lv__changelog-change">{c.change}</span>
            {c.by && <span class="lv__changelog-by">— {c.by} 提供</span>}
          </li>
        ))}
      </ul>
    </aside>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-lv-root]').forEach((root) => {
    const routeBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-route]')];
    // 只抓分區列上的按鈕；列本身用 data-row-zone，不能被這個選擇器掃到
    const zoneBtns = [...root.querySelectorAll<HTMLButtonElement>('.lv__zones [data-zone]')];
    const sections = [...root.querySelectorAll<HTMLElement>('[data-zone-section]')];
    const allRows = [...root.querySelectorAll<HTMLElement>('[data-routes]')];
    const count = root.querySelector<HTMLElement>('[data-lv-count]');
    const none = root.querySelector<HTMLElement>('[data-lv-none]');
    const total = allRows.length;

    let route = '';
    let zone = '';

    /** 這一列是否屬於目前選的路線 */
    const inRoute = (row: HTMLElement) =>
      !route || (row.dataset.routes ?? '').split(',').filter(Boolean).includes(route);

    const apply = () => {
      // 1) 分區按鈕：先算每區在目前路線下還剩幾處，沒有的就收起來
      for (const btn of zoneBtns) {
        const z = btn.dataset.zone ?? '';
        if (!z) continue; // 「全部」永遠留著
        const n = allRows.filter((r) => r.dataset.rowZone === z && inRoute(r)).length;
        btn.hidden = n === 0;
      }

      // 2) 選中的分區若被收起來，退回「全部」
      const active = zoneBtns.find((b) => b.dataset.zone === zone);
      if (zone && active?.hidden) {
        zone = '';
        for (const b of zoneBtns) b.classList.toggle('is-active', b.dataset.zone === '');
      }

      // 3) 列與分區段落
      let shown = 0;
      for (const row of allRows) {
        const hit = inRoute(row) && (!zone || row.dataset.rowZone === zone);
        row.hidden = !hit;
        if (hit) shown++;
      }
      for (const s of sections) {
        s.hidden = !s.querySelector('[data-routes]:not([hidden])');
      }

      if (count) count.textContent = shown === total ? `${total} 處` : `${shown} / ${total} 處`;

      if (none) {
        none.hidden = shown > 0;
        none.textContent = route
          ? `「${route}」還沒有標記任何地點，資料補上後就會出現在這裡。`
          : '目前的篩選沒有符合的地點。';
      }
    };

    for (const btn of routeBtns) {
      btn.addEventListener('click', () => {
        route = btn.dataset.route ?? '';
        for (const b of routeBtns) b.classList.toggle('is-active', b === btn);
        apply();
      });
    }
    for (const btn of zoneBtns) {
      btn.addEventListener('click', () => {
        zone = btn.dataset.zone ?? '';
        for (const b of zoneBtns) b.classList.toggle('is-active', b === btn);
        apply();
      });
    }

    apply();
  });
</script>

<script>
  // 等級差經驗對照：滑桿選等級，五個強弱帶即時重算
  document.querySelectorAll<HTMLElement>('[data-exp-root]').forEach((root) => {
    const expMap: Record<string, number> = JSON.parse(root.dataset.exp ?? '{}');
    const slider = root.querySelector<HTMLInputElement>('[data-exp-slider]')!;
    const levelEl = root.querySelector<HTMLElement>('[data-exp-level]')!;
    const tiersEl = root.querySelector<HTMLElement>('[data-exp-tiers]')!;

    const range = (from: number, to: number) => {
      const out: number[] = [];
      const step = from <= to ? 1 : -1;
      for (let n = from; step > 0 ? n <= to : n >= to; n += step) if (n >= 1) out.push(n);
      return out;
    };

    type Tier = {
      cls: string;
      badge: string;
      pct: string;
      desc: string;
      label: (L: number) => string;
      sub: string;
      mobs: (L: number) => number[];
      you?: boolean;
    };
    const TIERS: Tier[] = [
      {
        cls: 'is-bad',
        badge: '糟',
        pct: '≤63%',
        desc: '打得贏也虧：又危險，經驗又跳水',
        label: (L) => `Lv.${L + 6} ↑`,
        sub: '比你強 6 等以上',
        mobs: (L) => range(L + 6, L + 10),
      },
      {
        cls: 'is-best',
        badge: '最佳',
        pct: '100%',
        desc: '拿滿經驗，就打這一段',
        label: (L) => `Lv.${L}～${L + 5}`,
        sub: '跟你同等～強 5 等',
        mobs: (L) => range(L, L + 5),
        you: true,
      },
      {
        cls: 'is-good',
        badge: '佳',
        pct: '97～83%',
        desc: '還算划算，打得快就值得',
        label: (L) => `Lv.${L - 5}～${L - 1}`,
        sub: '比你弱 1～5 等',
        mobs: (L) => range(L - 1, L - 5),
      },
      {
        cls: 'is-so',
        badge: '次佳',
        pct: '80～70%',
        desc: '開始虧了，能往上就往上',
        label: (L) => `Lv.${L - 9}～${L - 6}`,
        sub: '比你弱 6～9 等',
        mobs: (L) => range(L - 6, L - 9),
      },
      {
        cls: 'is-bad',
        badge: '糟',
        pct: '≤67%',
        desc: '太弱了，該換地方練',
        label: (L) => `Lv.${L - 10} ↓`,
        sub: '比你弱 10 等以上',
        mobs: (L) => range(L - 10, L - 15),
      },
    ];

    const render = () => {
      const L = Number(slider.value);
      levelEl.textContent = `Lv.${L}`;
      tiersEl.innerHTML = '';
      for (const t of TIERS) {
        const row = document.createElement('div');
        row.className = `lv__exp-tier ${t.cls}`;
        const chips = t.mobs(L)
          .map((mob) => {
            const pct = expMap[String(L - mob)];
            return pct == null ? '' : `<i>Lv.${mob} → ${pct}%</i>`;
          })
          .join('');
        row.innerHTML =
          `<div class="t-range"><b>${t.label(L)}</b><span>${t.sub}</span></div>` +
          `<div class="t-rate"><em>${t.badge}</em><b>${t.pct}</b></div>` +
          `<div class="t-body"><p>${t.desc}</p><div class="t-chips">${chips}</div></div>` +
          (t.you ? `<span class="t-you">你在 Lv.${L}</span>` : '');
        tiersEl.append(row);
      }
    };

    slider.addEventListener('input', render);
    render();
  });
</script>

