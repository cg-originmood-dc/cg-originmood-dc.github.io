---
/**
 * 全站統一的出處標示。內容是從原 Google Sites 站台整理過來的，
 * 每一頁都連回它對應的來源頁面。
 */
interface Props {
  sourceUrl: string;
}
const { sourceUrl } = Astro.props;
---

<aside class="source-note">
  <span class="source-note__label">資料來源</span>
  <a href={sourceUrl} target="_blank" rel="noopener noreferrer">
    {decodeURIComponent(sourceUrl.replace('https://sites.google.com/view/goodluck2cg/', ''))
      || '原站首頁'}
  </a>
  <span class="source-note__hint">內容經重新整理，如有出入以原站為準</span>
</aside>

<style>
  .source-note {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    margin-block: 2.5rem 0;
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--accent);
    background: var(--surface-2);
    border-radius: 0 6px 6px 0;
    font-size: 0.875rem;
  }
  .source-note__label {
    font-weight: 700;
    color: var(--text-2);
  }
  .source-note a {
    color: var(--accent);
    word-break: break-all;
  }
  .source-note__hint {
    color: var(--text-3);
    font-size: 0.8125rem;
  }
</style>
