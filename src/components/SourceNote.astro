---
/**
 * 全站統一的出處標示，每一頁都連回它的來源。
 *
 * 大部分頁面來自原 Google Sites 站台，顯示站內路徑就夠了；少數頁面抄自別的站
 * （料理配方就來自蔚藍幻境），那要把網域寫出來，不然讀者會以為也是原站的東西。
 * 我們自己編的索引頁沒有來源，整塊不顯示。
 */
interface Props {
  sourceUrl?: string;
  label?: string;
}
const { sourceUrl, label: customLabel } = Astro.props;
const ORIGIN = 'https://sites.google.com/view/goodluck2cg/';
const fromOrigin = sourceUrl?.startsWith(ORIGIN) ?? false;
const label = customLabel || (!sourceUrl
  ? ''
  : fromOrigin
    ? decodeURIComponent(sourceUrl.slice(ORIGIN.length)) || '原站首頁'
    : new URL(sourceUrl).host);
---

{
  sourceUrl && (
    <aside class="source-note">
      <span class="source-note__label">資料來源</span>
      <a href={sourceUrl} target="_blank" rel="noopener noreferrer">
        {label}
      </a>
      <span class="source-note__hint">
        {fromOrigin ? '內容經重新整理，如有出入以原站為準' : '外站資料，與永恆初心可能有出入'}
      </span>
    </aside>
  )
}

<style>
  .source-note {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    margin-block: 2.5rem 0;
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--accent);
    background: var(--surface-2);
    border-radius: 0 6px 6px 0;
    font-size: 0.875rem;
  }
  .source-note__label {
    font-weight: 700;
    color: var(--text-2);
  }
  .source-note a {
    color: var(--accent);
    word-break: break-all;
  }
  .source-note__hint {
    color: var(--text-3);
    font-size: 0.8125rem;
  }
</style>
