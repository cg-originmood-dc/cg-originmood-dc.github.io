---
import { loadDataset, LIST_SEP, type Dataset } from '../lib/datasets';
import { thumbOf } from '../lib/thumbs';
import { renderCell } from '../lib/richtext';
import { hasPet } from '../lib/pets';

/**
 * 把 content/data/<name>.csv 渲染成可搜尋、可篩選、可排序的表格。
 * 這一層完全不知道資料在講什麼 —— 欄位由 CSV 決定，編輯者加欄位不必動程式。
 *
 * 操作方式刻意比照原站的嵌入表格：搜尋框 + 清空 + 篩選類別下拉，
 * 圖片滑過去會放大（原站的 .hover-container / .hover-image）。
 *
 * 有一種「只有少數列有值、值裡帶連結」的補充欄位（寵物表的「任務用途」就是），
 * 這種欄位多給一個勾選框只看有值的列。判斷條件是欄位內容有沒有 Markdown 連結，
 * 不寫死欄位名字 —— 之後別的 CSV 加同樣形態的欄位也會自動有這個勾選框。
 *
 * 表格那張用縮圖，放大預覽才用原圖。預覽那張是 display:none + loading="lazy"，
 * 瀏覽器不會事先下載，真的 hover 才抓——寵物頁 1069 列，差別是 56MB 對 20MB。
 */
/**
 * 「名稱(數量)、名稱(數量)」的材料欄。這種欄位折行時會折在名字或數量中間
 * （「黃月」換行「木(20)」），一項一項各自不折、只折在頓號之間就好。
 *
 * 認的是內容不是欄位名字：整格每一項都是「某某(數字)」才算，
 * 能力欄的「攻擊+141~225、必殺+1~5」與說明欄的散文都不會中。
 */
const QUANTITY_LIST = /^[^、]+\(\d+\)(?:、[^、]+\(\d+\))+$/;

interface Props {
  /** content/data/<name>.csv 檔名；與 dataset 擇一 */
  name?: string;
  /** 呼叫端已組合好的 Dataset（像寵物清單那種跨檔合併檢視），不經 loadDataset */
  dataset?: Dataset;
  /** 篩選欄改渲染成分頁籤（全部＋各值）取代下拉選單 */
  filterTabs?: boolean;
}
const { name, dataset: given, filterTabs = false } = Astro.props as Props;
const dataset = given ?? (name ? loadDataset(name) : null);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = (v: string) => (v.startsWith('/') ? base + v : v);
const cols = dataset?.columns.filter((c) => c !== dataset.imageColumn) ?? [];

/**
 * 名稱欄可點進寵物詳情頁的資料集。
 *
 * 這裡列的是「這張表的名稱欄裝的是寵物」，不是「這些名字有頁面」——
 * 後者交給 hasPet 逐列判斷，免得表裡混進沒收錄的寵物時發出死連結。
 */
const PET_NAME_DATASETS = new Set(['專屬寵物', '魔力原始寵物', '寵物清單']);
const linkNameCol =
  dataset && PET_NAME_DATASETS.has(dataset.name) && cols.includes('名稱') ? '名稱' : null;
const petDetailHref = (petName: string) =>
  hasPet(petName) ? `${base}/寵物資料/${encodeURIComponent(petName)}` : null;

/**
 * 圖欄的位置：寵物表的圖是該列主角的肖像，跟名稱一樣放最前面；
 * 其他表的圖是佐證用的存檔截圖，放最後才不會把名稱、材料往右擠。
 */
const imageFirst = dataset ? PET_NAME_DATASETS.has(dataset.name) : false;
---

{
  !dataset ? (
    <p class="dataset-missing">找不到資料集 <code>{name}</code>（應在 content/data/{name}.csv）</p>
  ) : (
    <figure class="dataset" data-dataset={dataset.name} data-filter-active="">
      {filterTabs && dataset.filterColumn && (
        <div
          class="dataset__tabs"
          role="group"
          aria-label={`篩選${dataset.filterColumn.name}`}
          data-filter-col={cols.indexOf(dataset.filterColumn.name)}
        >
          <button type="button" class="dataset__tab is-active" data-value="">全部</button>
          {dataset.filterColumn.values.map((v) => (
            <button type="button" class="dataset__tab" data-value={v}>{v}</button>
          ))}
        </div>
      )}
      <figcaption class="dataset__bar">
        <label class="dataset__field">
          搜尋:
          <input type="search" placeholder="輸入關鍵字" autocomplete="off" />
        </label>
        <button type="button" class="dataset__clear">清空</button>
        {!filterTabs && dataset.filterColumn && (
          <label class="dataset__field">
            篩選{dataset.filterColumn.name}:
            <select data-filter-col={cols.indexOf(dataset.filterColumn.name)}>
              <option value="">全部</option>
              {dataset.filterColumn.values.map((v) => (
                <option value={v}>{v}</option>
              ))}
            </select>
          </label>
        )}
        {dataset.noteColumn && (
          <label class="dataset__check">
            <input type="checkbox" data-note-col={cols.indexOf(dataset.noteColumn)} />
            只看有{dataset.noteColumn}的
          </label>
        )}
        <output class="dataset__count">{dataset.rows.length} 筆</output>
      </figcaption>

      <div class="dataset__scroll">
        <table>
          <thead>
            <tr>
              {dataset.imageColumn && imageFirst && <th scope="col" class="col-img">圖</th>}
              {dataset.action && <th scope="col" class="col-act">工具</th>}
              {cols.map((c, i) => (
                <th
                  scope="col"
                  data-sort-index={i}
                  tabindex="0"
                  role="button"
                  aria-sort={
                    dataset.defaultSort?.column === c
                      ? dataset.defaultSort.dir === 'desc'
                        ? 'descending'
                        : 'ascending'
                      : undefined
                  }
                >
                  {c}
                </th>
              ))}
              {dataset.imageColumn && !imageFirst && <th scope="col" class="col-img">圖</th>}
            </tr>
          </thead>
          <tbody>
            {dataset.rows.map((row) => {
              const petName = linkNameCol ? (row[linkNameCol] ?? '').trim() : '';
              const detail = petName ? petDetailHref(petName) : null;
              const imgCell = dataset.imageColumn ? (
                <td class="col-img">
                  {row[dataset.imageColumn] ? (
                    detail ? (
                      <a class="dataset__img-link" href={detail}>
                        <span class="hoverpic">
                          <img src={src(thumbOf(row[dataset.imageColumn]))} alt={petName} loading="lazy" decoding="async" />
                          <img class="hoverpic__big" src={src(row[dataset.imageColumn])} alt="" loading="lazy" decoding="async" />
                        </span>
                      </a>
                    ) : (
                      <span class="hoverpic">
                        <img src={src(thumbOf(row[dataset.imageColumn]))} alt="" loading="lazy" decoding="async" />
                        <img class="hoverpic__big" src={src(row[dataset.imageColumn])} alt="" loading="lazy" decoding="async" />
                      </span>
                    )
                  ) : null}
                </td>
              ) : null;
              return (
                <tr
                  class={detail ? 'dataset__row--link' : undefined}
                  data-href={detail ?? undefined}
                  data-filter={
                    dataset.filterColumn ? (row[dataset.filterColumn.name] ?? '').trim() : undefined
                  }
                >
                  {imageFirst && imgCell}
                  {dataset.action && (
                    <td class="col-act">
                      {row[dataset.action.column] ? (
                        <a
                          class="dataset__act"
                          href={dataset.action.url(row[dataset.action.column])}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {dataset.action.label}
                        </a>
                      ) : null}
                    </td>
                  )}
                  {cols.map((c) => {
                    const value = row[c] ?? '';
                    if (c === linkNameCol && detail) {
                      return (
                        <td class={dataset.wrapColumns.includes(c) ? 'is-wrap' : undefined}>
                          <a class="dataset__name-link" href={detail}>{value}</a>
                        </td>
                      );
                    }
                    const linked = /\[[^\]]+\]\([^)]+\)/.test(value);
                    // 一格好幾條的欄位（採集地點最多九個點）拆成一行一條。
                    // 串成一行的話括號座標一路接下去，要數到第幾個斜線才知道在看哪一個點。
                    const items = value.includes(LIST_SEP) ? value.split(LIST_SEP) : null;
                    const parts = !items && QUANTITY_LIST.test(value) ? value.split('、') : null;
                    const classes = [
                      dataset.wrapColumns.includes(c) ? 'is-wrap' : '',
                      c === dataset.noteColumn ? 'is-note' : '',
                      items ? 'is-list' : '',
                      parts ? 'is-items' : '',
                    ].filter(Boolean).join(' ');
                    return linked ? (
                      <td class={classes || undefined} set:html={renderCell(value, base)} />
                    ) : items ? (
                      <td class={classes}>
                        {items.map((item) => (
                          <span>{item}</span>
                        ))}
                      </td>
                    ) : parts ? (
                      // 頓號留在前一項的尾巴，折行才會折在頓號後面而不是前面
                      <td class={classes}>
                        {parts.map((part, i) => (
                          <span>{i < parts.length - 1 ? `${part}、` : part}</span>
                        ))}
                      </td>
                    ) : (
                      <td class={classes || undefined}>{value}</td>
                    );
                  })}
                  {!imageFirst && imgCell}
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </figure>
  )
}

<script>
  // 純靜態站，所以搜尋/篩選/排序都在瀏覽器端做，不需要任何後端。
  document.querySelectorAll<HTMLElement>('.dataset').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('input[type=search]');
    const select = root.querySelector<HTMLSelectElement>('select[data-filter-col]');
    // 篩選有兩種長相：下拉（select）或分頁籤（tabs），同一時間只會有一種
    const tabs = root.querySelector<HTMLElement>('.dataset__tabs');
    const note = root.querySelector<HTMLInputElement>('input[data-note-col]');
    const clear = root.querySelector<HTMLButtonElement>('.dataset__clear');
    const count = root.querySelector<HTMLOutputElement>('.dataset__count');
    const tbody = root.querySelector('tbody');
    if (!tbody) return;
    const rows = Array.from(tbody.rows);
    const total = rows.length;
    // 資料欄前面可能插了肖像圖欄（寵物表）與工具按鈕欄，兩者都不在 cols 裡，
    // 所以 data-sort-index / data-filter-col 這些索引都要加上這個偏移。
    // 偏移直接數「第一個資料表頭之前有幾個 th」——
    // 佐證截圖表的圖欄擺在最後面，不能算進來。
    const lead = Math.max(
      0,
      Array.from(root.querySelectorAll('thead th')).findIndex((th) =>
        th.hasAttribute('data-sort-index'),
      ),
    );
    const noteCol = note ? Number(note.dataset.noteCol) + lead : -1;

    // 搜尋字串先算好：一來 1069 列每次按鍵都跑 textContent 很浪費，
    // 二來要把工具按鈕的字排除掉，否則搜「算」會命中每一列。
    // 綁在列物件上而不是用陣列索引 —— 排序會重排 rows，索引會對不上。
    const hay = new Map(
      rows.map((tr) => [
        tr,
        Array.from(tr.cells)
          .filter((td) => !td.classList.contains('col-act'))
          // 一行一條的欄位要自己補回分隔空白，textContent 會把相鄰兩條黏成一個字串
          .map((td) =>
            td.classList.contains('is-list')
              ? Array.from(td.children, (n) => n.textContent).join(' ')
              : td.textContent,
          )
          .join(' ')
          .toLowerCase(),
      ]),
    );

    const apply = () => {
      const q = input?.value.trim().toLowerCase() ?? '';
      const filterEl = select ?? tabs;
      const want =
        select?.value ??
        tabs?.querySelector('.is-active')?.getAttribute('data-value') ??
        '';
      const col = want && filterEl ? Number(filterEl.dataset.filterCol) + lead : -1;
      const onlyNote = note?.checked ?? false;
      let shown = 0;
      for (const tr of rows) {
        const hit =
          (!q || hay.get(tr)!.includes(q)) &&
          (!want || (tr.dataset.filter ?? tr.cells[col]?.textContent?.trim()) === want) &&
          (!onlyNote || !!tr.cells[noteCol]?.textContent?.trim());
        tr.hidden = !hit;
        if (hit) shown++;
      }
      // 讓 CSS 知道現在停在哪個篩選值（寵物清單「全部」檢視的列底色靠這個）
      root.dataset.filterActive = want;
      if (count) count.textContent = shown === total ? `${total} 筆` : `${shown} / ${total} 筆`;
    };

    const resetTabs = () => {
      tabs
        ?.querySelectorAll<HTMLButtonElement>('.dataset__tab')
        .forEach((b) => b.classList.toggle('is-active', b.dataset.value === ''));
    };
    tabs?.querySelectorAll<HTMLButtonElement>('.dataset__tab').forEach((btn) => {
      btn.addEventListener('click', () => {
        tabs.querySelectorAll('.dataset__tab').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        apply();
      });
    });

    input?.addEventListener('input', apply);
    select?.addEventListener('change', apply);
    note?.addEventListener('change', apply);
    clear?.addEventListener('click', () => {
      if (input) input.value = '';
      if (select) select.value = '';
      resetTabs();
      if (note) note.checked = false;
      apply();
    });

    // CSV 進來就排好的話，表頭已經帶著 aria-sort。把那個狀態接手過來，
    // 否則第一次點下去會照「新欄位一律升冪」的規則，先跳到相反方向再回來。
    const preset = root.querySelector<HTMLTableCellElement>('th[data-sort-index][aria-sort]');
    let sortCol = preset ? Number(preset.dataset.sortIndex) : -1;
    let asc = preset ? preset.getAttribute('aria-sort') === 'ascending' : true;
    root.querySelectorAll<HTMLTableCellElement>('th[data-sort-index]').forEach((th) => {
      const sort = () => {
        const idx = Number(th.dataset.sortIndex);
        const cell = idx + lead;
        asc = sortCol === idx ? !asc : true;
        sortCol = idx;

        const collator = new Intl.Collator('zh-Hant', { numeric: true, sensitivity: 'base' });
        rows.sort((a, b) => {
          const x = a.cells[cell]?.textContent?.trim() ?? '';
          const y = b.cells[cell]?.textContent?.trim() ?? '';
          return (asc ? 1 : -1) * collator.compare(x, y);
        });
        rows.forEach((r) => tbody.appendChild(r));
        root.querySelectorAll('th[data-sort-index]').forEach((o) => o.removeAttribute('aria-sort'));
        th.setAttribute('aria-sort', asc ? 'ascending' : 'descending');
      };
      th.addEventListener('click', sort);
      th.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          sort();
        }
      });
    });

    // 點整列（非連結區）也可進入寵物詳情。
    // 帶修飾鍵（Ctrl/Cmd＝新分頁、Shift＝新視窗）的點擊不接手——
    // 接了會變成在同一分頁跳走，把使用者要開新分頁的意圖吃掉；
    // 要開新分頁請點名稱那個真連結，瀏覽器原生行為才是對的。
    tbody.addEventListener('click', (e) => {
      if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey || e.button !== 0) return;
      const t = e.target as HTMLElement;
      if (t.closest('a')) return;
      const tr = t.closest('tr[data-href]') as HTMLTableRowElement | null;
      if (!tr?.dataset.href) return;
      location.href = tr.dataset.href;
    });
  });
</script>
